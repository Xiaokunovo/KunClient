verify-*.png

# ── ⑥ 运行时数据（机器人 / 服务端）─────────────────────────────────────────
qqbot-dafeiyu/data/
qqbot-dafeiyu/__pycache__/
qqbot-dafeiyu/napcat/
qqbot-dafeiyu/tmp-*
qqbot-dafeiyu/config.json
!qqbot-dafeiyu/config.example.json

**/node_modules/
_archive/website/.next/
_archive/website/out/

# ── ⑦ 工具链缓存 ───────────────────────────────────────────────────────────
tools/dotnet-tools/.store/
tools/*/.store/
7z-extra/

# ── ⑧ 更新签名私钥（2026-10-31）─────────────────────────────────────────────
# 🔴 绝对不进仓库：这是更新包签名的私钥。它一旦泄露，任何人都能签出
#    「能通过客户端校验」的恶意更新包 —— 整个自动更新的安全模型就废了。
#    备份到离线介质，不要提交、不要上传、不要放进任何云同步目录。
.keys/
*.pem
*.sig.json

# ── ⑨ 本地审计 / 取证产物（2026-10-31）─────────────────────────────────────
# .preview/ 是截图取证目录，.acl-recovery/ 是沙箱 ACL 诊断产物 —— 都是本机的，
# 对别人没意义，进仓库只会变成噪音。
.preview/
.acl-recovery/
