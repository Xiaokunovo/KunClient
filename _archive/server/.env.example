# 服务端环境变量示例：复制为 server/.env（不入库）后按需导出，或直接在启动脚本/容器中设置。
# 环境变量优先级最高，会覆盖 server/config.json 与 server/config.local.json 的同名项。

# 监听端口
PORT=3000

# JWT 签名密钥（留空则自动生成并持久化到 server/.runtime/jwt.secret）
JWT_SECRET=replace_with_a_long_random_string
# 自定义密钥落盘位置（可选）
# JWT_SECRET_FILE=/var/lib/kunclient/jwt.secret

# 对外访问地址（用于版本接口 download_url、邮件链接等；留空回退 http://localhost:<PORT>）
PUBLIC_URL=http://your-server-ip:3000

# 数据库文件（留空使用 server/database.sqlite；相对路径基于 server 目录解析）
DB_PATH=

# 管理员账号（password 留空则跳过管理员播种/同步）
ADMIN_USER=admin
ADMIN_PASS=replace_with_admin_password
ADMIN_EMAIL=admin@example.com

# 邮件（验证码/通知）；MAIL_DISABLE=1 可强制关闭
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=you@example.com
MAIL_PASS=replace_with_smtp_auth_code
MAIL_FROM=KunClient <you@example.com>
# MAIL_DISABLE=0

# 部署脚本（tools/*.js）使用的 SSH 凭据，未设置时读取 server/config.json → deploy
# DEPLOY_HOST=your-server-ip
# DEPLOY_SSH_PORT=22
# DEPLOY_USER=root
# DEPLOY_PASSWORD=replace_with_ssh_password
# DEPLOY_REMOTE_BASE=/www/wwwroot/KunClient-server
# DEPLOY_APP_PORT=3000
