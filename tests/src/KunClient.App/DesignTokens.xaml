<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════
         KunFlashTool — 设计令牌（工具箱面板 / Toolbox Panel）
         所有颜色/圆角/字体集中于此；ThemeManager 在运行时按主题整体替换
         Theme.* 与 Theme.AccentGradient。浅色为默认主题。
         色板血统：参考稿「沐妍工具箱」（经典桌面刷机工具）——
           · 冷白偏蓝窗底 + 纯白面板 + 1px 淡蓝描边（面板靠描边分区，不靠留白）
           · 唯一强调色是**天空蓝 #7AB8F3**，用于页签下划线、进度条填充、按钮描边
           · 文字近黑 #1F2329（参考稿看着偏灰是 JPG 压缩把字芯糊掉了，别照抄成中灰）
           · 状态色只在「日志 OK/告警/错误」出现，不做装饰
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- ═══════════════════════════════════════════════════════════════════
         圆角：**液态玻璃标尺（大圆角）** + 一支方块。判级看**角色**，不看手感。
         🔴 2026-10-08 二次修订：用户明确「圆角还是要的」+「想要的是 iOS 系统的液态玻璃」。
            上一轮把药丸压成 4 是把话听反了 —— 用户不要的是**正圆/椭圆形的点**，不是圆角。
            所以：药丸档恢复 999，并把整体圆角**放大到 iOS 的量级**
            （iOS Liquid Glass 的容器圆角明显大于经典桌面工具，小控件基本是胶囊）。

           ① 2    R.Square  —— **微观方块专用**（状态点、小色块 ≤10px 见方）。
                              8~10px 见方配 4 会被 WPF 收成正圆，只配 2 才是方的。
           ② 6    R.Micro   —— 勾选框、小色块、内嵌小标签。
           ③ 10   R.Control —— 控件：输入框 / 按钮 / 下拉 / 分段。
           ④ 16   R.Card    —— 容器：卡片 / 分组框 / 面板（iOS 的大圆角观感）。
           ⑤ 18   R.Dialog  —— 弹层外壳（自绘圆角窗）。
           ⑥ 999  R.Tag / R.Thumb —— 药丸：标签片、滑块钮。**两端半圆**，只有真·胶囊语义才用。
                              🔴 分组标题的玻璃片**不要**用这一档 —— 用户明确说「这个圆形我不想要」
                                 （截图指的就是标题那圈两端半圆的白片）。它走 ⑦。

           ⑦ 4    R.HeaderChip —— **分组/分组框标题的玻璃片专用**（ToolGroup / EdlGlassGroup）。
                              15~16px 高的标题片：配 4 是明确的圆角矩形（垂直中段有 7px 是平的）；
                              配 6 已经接近半圆（6 / 7.5），配 999 就是一枚胶囊
                              —— 后两者都是用户不要的形状（原话「这个圆形我不想要」）。
                              想更圆一点改这一个值即可，别去动各页面的字面量。
                              单独给它一支而不是复用 R.Micro，是因为两者改动的理由不同：
                              以后调标题片的圆润度不该顺带把勾选框/小色块也改了。

         ⚠️ 半径必须配得上尺寸：6 用在 13px 的勾选框上会变成圆球 → 那种取 R.Micro。
            改 token 值时全站同档一起变，别只改一处。
         ═══════════════════════════════════════════════════════════════════ -->
    <CornerRadius x:Key="R.Square">2</CornerRadius>
    <CornerRadius x:Key="R.Micro">6</CornerRadius>
    <CornerRadius x:Key="R.Control">10</CornerRadius>
    <CornerRadius x:Key="R.Input">10</CornerRadius>
    <CornerRadius x:Key="R.Button">10</CornerRadius>
    <CornerRadius x:Key="R.Tag">999</CornerRadius>
    <CornerRadius x:Key="R.Segment">10</CornerRadius>
    <CornerRadius x:Key="R.Chip">999</CornerRadius>
    <CornerRadius x:Key="R.HeaderChip">4</CornerRadius>
    <CornerRadius x:Key="R.Card">10</CornerRadius>
    <CornerRadius x:Key="R.Window">18</CornerRadius>
    <!-- 弹层外壳档，只给自绘圆角窗（AllowsTransparency + 自画边框）用 -->
    <CornerRadius x:Key="R.Dialog">18</CornerRadius>
    <!-- 顶条：与 R.Dialog 配对。原生标题栏窗的客户区顶角是直角（圆角在标题栏那侧），
         那种窗**不要**引用它，否则顶两角会缺一块窗底色。 -->
    <CornerRadius x:Key="R.DialogTop">18,18,0,0</CornerRadius>
    <!-- 底条：原生标题栏对话框的**专用**值。
         6 ≤ 系统窗口圆角(Win11=8)：Win11 下被系统裁切、完全看不出；
         Win10 直角窗下显出 6px 圆角，像底栏自己收的边。
         ⚠️ 绝不能改成 12（弹层档）—— 12 > 8，底边两角会露出约 4px 宽的
            窗底色(Theme.Bg)缝，看着像底栏没贴齐窗口。 -->
    <CornerRadius x:Key="R.DialogBottom">0,0,6,6</CornerRadius>
    <CornerRadius x:Key="R.Thumb">999</CornerRadius>

    <!-- 字体 -->
    <FontFamily x:Key="F.Body">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="F.Mono">Cascadia Code, Consolas, Microsoft YaHei UI</FontFamily>

    <!-- ═══════════════════════════════════════════════════════════════════
         交互动效缓动（供 XAML 控件模板里的 hover/press 补间使用）。
         曲线与 Services/Motion.cs 的 AppleEase（0.32,0.72,0,1，快起慢收）同族。
         ⚠️ 只有「模板级 hover/press」用这里；需要位移/联动/排队入场等复杂动效，
            一律走 Motion.cs（AppleEase / SilkEase / ExitEase），不要在这里造第二套曲线。
         ═══════════════════════════════════════════════════════════════════ -->
    <CubicEase x:Key="Ease.Out" EasingMode="EaseOut" />
    <CubicEase x:Key="Ease.In" EasingMode="EaseIn" />

    <!-- 浅色主题（默认，运行时由 ThemeManager 整体替换）
         「淡蓝天」色板：冷白窗底 + 纯白面板 + 淡蓝描边 + 天空蓝强调色。
         参考值（从参考稿逐区采样 + 自动找线得到，不是目测）：
           窗底 #FAFBFF / 条带 #F0F4FF / 表头 #F4F7FE / 描边 #D5DEEB / 强调 #7AB8F3。
         ⚠️ 强调色 #7AB8F3 很浅，**不能配白字**（对比度约 2:1）：
            压在它上面的文字一律用 AccentText（深海军蓝 #10304F）；
            需要「蓝字」的地方（品牌名、链接、选中页签）用 AccentText2。 -->
    <SolidColorBrush x:Key="Theme.Bg" Color="#FAFBFF" />
    <!-- 页面根背景（半透明，透出自定义动态背景图；深浅主题由 ThemeManager 运行时替换） -->
    <SolidColorBrush x:Key="Theme.BgTint" Color="#A0FAFBFF" />
    <SolidColorBrush x:Key="Theme.Surface" Color="#94FFFFFF" />
    <SolidColorBrush x:Key="Theme.SurfaceAlt" Color="#7AF4F7FE" />
    <SolidColorBrush x:Key="Theme.SurfaceElevated" Color="#9EFFFFFF" />
    <SolidColorBrush x:Key="Theme.TitleBarBg" Color="#F4F7FE" />
    <SolidColorBrush x:Key="Theme.Border" Color="#D5DEEB" />
    <SolidColorBrush x:Key="Theme.BorderSubtle" Color="#E4EAF4" />
    <SolidColorBrush x:Key="Theme.CardBorder" Color="#D5DEEB" />
    <SolidColorBrush x:Key="Theme.CardBg" Color="#94FFFFFF" />
    <SolidColorBrush x:Key="Theme.TextPrimary" Color="#1F2329" />
    <SolidColorBrush x:Key="Theme.TextSecondary" Color="#55606C" />
    <SolidColorBrush x:Key="Theme.TextTertiary" Color="#939EAB" />
    <SolidColorBrush x:Key="Theme.Accent" Color="#7AB8F3" />
    <SolidColorBrush x:Key="Theme.Accent2" Color="#5FA6EE" />
    <SolidColorBrush x:Key="Theme.AccentText" Color="#10304F" />
    <SolidColorBrush x:Key="Theme.AccentText2" Color="#3E8FE0" />
    <SolidColorBrush x:Key="Theme.AccentSubtle" Color="#EAF3FE" />
    <SolidColorBrush x:Key="Theme.AccentSoft" Color="#337AB8F3" />
    <SolidColorBrush x:Key="Theme.AccentHover" Color="#5FA6EE" />
    <SolidColorBrush x:Key="Theme.AccentPressed" Color="#4E93DC" />
    <SolidColorBrush x:Key="Theme.Hover" Color="#EEF4FE" />
    <SolidColorBrush x:Key="Theme.Press" Color="#E2EDFC" />
    <SolidColorBrush x:Key="Theme.InputBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Theme.InputBorder" Color="#CFDDEE" />
    <SolidColorBrush x:Key="Theme.InputHover" Color="#A9C7E6" />
    <SolidColorBrush x:Key="Theme.InputFocus" Color="#7AB8F3" />
    <SolidColorBrush x:Key="Theme.Success" Color="#34A06A" />
    <SolidColorBrush x:Key="Theme.SuccessBg" Color="#EBF7F0" />
    <SolidColorBrush x:Key="Theme.Warning" Color="#C07A16" />
    <SolidColorBrush x:Key="Theme.WarningBg" Color="#FDF5E8" />
    <SolidColorBrush x:Key="Theme.Danger" Color="#D0503F" />
    <SolidColorBrush x:Key="Theme.DangerBg" Color="#FCEFED" />
    <!-- 结果判定用的纯绿：与 Theme.Success 共用同一支，避免两个绿打架。 -->
    <SolidColorBrush x:Key="Theme.OkGreen" Color="#34A06A" />
    <SolidColorBrush x:Key="Theme.OkGreenBg" Color="#EBF7F0" />
    <SolidColorBrush x:Key="Theme.Info" Color="#3E8FE0" />
    <SolidColorBrush x:Key="Theme.InfoBg" Color="#EAF3FE" />
    <SolidColorBrush x:Key="Theme.LogInfo" Color="#3E8FE0" />
    <SolidColorBrush x:Key="Theme.LogSuccess" Color="#34A06A" />
    <SolidColorBrush x:Key="Theme.LogWarning" Color="#C07A16" />
    <SolidColorBrush x:Key="Theme.LogError" Color="#D0503F" />
    <SolidColorBrush x:Key="Theme.ProgTrack" Color="#EDF3FA" />
    <SolidColorBrush x:Key="Theme.AccentBlue" Color="#7AB8F3" />
    <SolidColorBrush x:Key="Theme.WarningText" Color="#C07A16" />
    <SolidColorBrush x:Key="Theme.ShadowColor" Color="#14000000" />
    <SolidColorBrush x:Key="Theme.RowHover" Color="#F2F7FE" />
    <SolidColorBrush x:Key="Theme.RowSelected" Color="#DFEBFB" />

    <!-- ═══════════════════════════════════════════════════════════════════
         工具箱版式专用令牌（分组框 / 表格 / 页签 / 进度条 / 状态栏）
         ⚠️ 这些键同样要出现在 ThemeManager 的深浅两张 token 表里，
            否则切到深色主题时它们不会跟着换 —— 界面上会留下几块浅色补丁。
         ═══════════════════════════════════════════════════════════════════ -->
    <!-- 面板标题条 / 表头底色 -->
    <SolidColorBrush x:Key="Theme.PanelHeadBg" Color="#F4F7FE" />
    <!-- 表格网格线（比 BorderSubtle 略深，屏幕上要看得见格子） -->
    <SolidColorBrush x:Key="Theme.GridLine" Color="#E9EFF7" />
    <!-- 页签条底色（参考稿是淡蓝带 + 竖分隔线；选中页签白底 + 天空蓝下划线） -->
    <SolidColorBrush x:Key="Theme.TabStripBg" Color="#F0F4FF" />
    <!-- 底部状态栏底色 -->
    <SolidColorBrush x:Key="Theme.StatusBarBg" Color="#F0F4FF" />
    <!-- 进度条上的百分比文字（压在蓝色填充上） -->
    <SolidColorBrush x:Key="Theme.ProgressText" Color="#FFFFFF" />
    <!-- 胶囊按钮（参考稿里所有按钮都是「白底 + 淡蓝描边 + 蓝灰字」）：
         描边比分组框描边略偏蓝，文字用低饱和蓝灰 —— 这两支只在按钮上用，别挪作他用。 -->
    <SolidColorBrush x:Key="Theme.BtnBorder" Color="#B7CBDE" />
    <SolidColorBrush x:Key="Theme.BtnText" Color="#5B7FA0" />
    <SolidColorBrush x:Key="Theme.BtnHoverBg" Color="#F3F8FF" />
    <!-- 分组框标题「分区管理 / 设备信息 / 日志」的字色：比按钮字更深一档的藏青，
         参考稿里它明显偏蓝、又不到强调蓝那么亮。 -->
    <SolidColorBrush x:Key="Theme.GroupHeader" Color="#3F5570" />

    <!-- ═══════════════════════════════════════════════════════════════════
         液态玻璃（Liquid Glass）令牌 —— 玻璃 = 半透明面板 + 顶边高光/底边暗影 + 中段描边
         玻璃的「磨砂」不是在这层做的：壁纸先被 DynamicBackground 按 BackgroundBlur
         模糊，再透过上面这些半透明底色（Theme.Surface / CardBg / InputBg …）露出来。
         ⚠️ 三个颜色令牌与三支 Glass.* 描边同样要出现在 ThemeManager 的深浅两张表里，
            否则深色主题下它们不会跟着换（描边由 ThemeManager 运行时整体重建）。
         ═══════════════════════════════════════════════════════════════════ -->
    <!-- 顶边高光：光从上方来，玻璃的上沿最亮。
         浅色给到 85% —— 面板本身近白，65% 的高光压在白面板上几乎看不出来，
         而这条边是压在**壁纸**上的，够亮才读得出「玻璃上沿接了一道光」。 -->
    <SolidColorBrush x:Key="Theme.GlassEdgeTop" Color="#F2FFFFFF" />
    <!-- 底边暗影：给玻璃一个「厚度」，否则面板贴在壁纸上是飘着的 -->
    <SolidColorBrush x:Key="Theme.GlassEdgeBottom" Color="#40000000" />
    <!-- 近不透明玻璃：组标题压线白片、选中页签这类「必须盖住底下那条线」的地方 -->
    <SolidColorBrush x:Key="Theme.GlassSolid" Color="#F2FFFFFF" />

    <!-- 三支玻璃描边：顶高光 → 中段主题描边色 → 底暗影。
         中段**必须**是主题描边色 —— 没设背景图时面板和窗底都是白的，
         只有高光/暗影的话整圈轮廓会消失（顶边白对白、底边黑太淡）。
         运行时由 ThemeManager.BuildGlassEdge 按主题用同一套配方重建。 -->
    <LinearGradientBrush x:Key="Glass.Edge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2FFFFFF" Offset="0" />
        <GradientStop Color="#D5DEEB" Offset="0.07" />
        <GradientStop Color="#D5DEEB" Offset="0.88" />
        <GradientStop Color="#33000000" Offset="1" />
    </LinearGradientBrush>
    <!-- 按钮：中段换 BtnBorder 的蓝灰（次级按钮那圈描边） -->
    <LinearGradientBrush x:Key="Glass.BtnEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2FFFFFF" Offset="0" />
        <GradientStop Color="#B7CBDE" Offset="0.07" />
        <GradientStop Color="#B7CBDE" Offset="0.88" />
        <GradientStop Color="#33000000" Offset="1" />
    </LinearGradientBrush>
    <!-- 输入框：中段换 InputBorder -->
    <LinearGradientBrush x:Key="Glass.InputEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2FFFFFF" Offset="0" />
        <GradientStop Color="#CFDDEE" Offset="0.07" />
        <GradientStop Color="#CFDDEE" Offset="0.88" />
        <GradientStop Color="#33000000" Offset="1" />
    </LinearGradientBrush>

    <!-- 强调色（纯色；键保留以兼容运行时重建与既有引用） -->
    <LinearGradientBrush x:Key="Theme.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7AB8F3" Offset="0" />
        <GradientStop Color="#7AB8F3" Offset="1" />
    </LinearGradientBrush>

    <!-- 品牌渐变（近乎纯色，登录/品牌面板用） -->
    <LinearGradientBrush x:Key="Grad.Brand" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7AB8F3" Offset="0" />
        <GradientStop Color="#5FA6EE" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
