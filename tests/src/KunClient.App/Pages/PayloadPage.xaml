<services:BasePage x:Class="KunFlashTool.App.Pages.PayloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:KunFlashTool.App.Services">
    <!-- ═══════════════════════════════════════════════════════════════════
         Payload 解析 / 提取 —— 工具箱版式（照 OnePlusFlashPage / AppManagerPage 配方）
         ───────────────────────────────────────────────────────────────────
         ① 页头删除（页签名「Payload」就是标题）；页根 = Grid + Theme.BgTint + Tool.PagePad。
         ② 两列：左 316（本页 OwnRail:true，外壳共用左栏让位，左列出自本页）
              ·「固件地址」—— URL 输入 + 解析；本地 payload.bin 只读框 + 文件夹图标钮
              ·「日志」—— TxtLog 撑满左列剩余高度
            右 *   ——「分区管理」（保存路径行 + 全选/取消全选 + 分区表 + 解析/提取/搜索）
                     「解析信息」（细进度条 + 进度文字 + 解析摘要）
         ③ 页内不再有页面级状态栏：任务名与进度一律上报 ShellStatus，由外壳 ③ 通栏双进度条
            + ④ 分段状态栏显示。
         ④ 卡片全部换成 ToolGroup 分组框（标题变 Header、圆角与内衬由模板负责，
            页面里不再套带圆角的 Border）。

         ⚠️ 关于「解析信息」分组框里那条 ProgressBar：
            **页内进度条已由外壳 ③ 承担，此控件保留仅为兼容 code-behind，后续删除需同步改 .cs。**
            原因：PayloadPage.xaml.cs 的提取流程每写一个分区就执行 ProgressBar.Value = …，
            并把同一个值同时上报 ShellStatus。改 x:Name 或删控件都会让编译期字段失配，
            所以本轮只做版式（细条 + 与文字对齐），不动它的名字与 .cs 逻辑。

         ⚠️ 隐形契约（重构布局时不得破坏）：
            · TxtLog —— BasePage.LogTarget / PageLog 按名字找日志框；
            · NotifyBar / NotifyIcon / NotifyText 三件套 —— BasePage.FindName 弹提示；
            · TxtPayloadFile 是「当前 payload.bin 路径」的唯一来源，代码后置全程读它
              （从可编辑输入框换成了只读展示框，选文件走右侧文件夹图标钮）；
            · ProgressBar / TxtProgress / TxtInfo 三个 x:Name 一个都不能改 ——
              解析与提取流程按名字找控件。
         ═══════════════════════════════════════════════════════════════════ -->
    <Grid Background="{DynamicResource Theme.BgTint}" Margin="{StaticResource Tool.PagePad}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 主区地板 300：左列「固件地址 + 日志」至少要这么高才不挤 -->
            <RowDefinition Height="*" MinHeight="300"/>
        </Grid.RowDefinitions>

        <!-- 页面内通知条：结构不可改（BasePage 靠 FindName 取这三个名字），
             经典外观 = 浅蓝底 + 蓝描边；显示时由 Notify.Show 按成败覆写配色。 -->
        <Border x:Name="NotifyBar" Grid.Row="0" Visibility="Collapsed"
                CornerRadius="{StaticResource R.Control}" Padding="10,7" Margin="0,0,0,8"
                Background="{DynamicResource Theme.InfoBg}"
                BorderBrush="{DynamicResource Theme.Info}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="NotifyIcon" FontSize="12.5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="NotifyText" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ═══════════ 主区：左列（固件地址 + 日志） + 右列（分区管理 + 解析信息） ═══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 左列 316：与外壳左栏（DeviceLogRail）同宽 —— 两者不会同时出现 -->
                <ColumnDefinition Width="316"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- ── 左列：固件地址（Auto）+ 日志（*） ── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="140"/>
                </Grid.RowDefinitions>

                <!-- 分组框：固件地址（URL 只是登记，当前版本没有在线下载；本地文件走只读框 + 图标钮） -->
                <HeaderedContentControl Grid.Row="0" Style="{StaticResource ToolGroup}" Header="固件地址">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                        </Grid.RowDefinitions>

                        <!-- URL 行：点「解析」按本地流程解析 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="URL:" Style="{StaticResource ToolFieldLabel}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtFirmwareUrl" Style="{StaticResource ThemedInputBox}"
                                 Padding="8,3" Height="26" Margin="0,0,6,0"
                                 ToolTip="固件地址：http(s) 链接（暂不支持直接下载）或本机 payload.bin 的完整路径"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="解析" Style="{StaticResource ThemedFlatButton}"
                                Click="BtnParseUrl_Click" Height="26"
                                ToolTip="解析该地址对应的 payload.bin（在线地址请先下载到本地）"/>

                        <!-- 本地行：只读展示当前 payload.bin，选文件走右侧文件夹图标钮 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="本地:" Style="{StaticResource ToolFieldLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtPayloadFile" Style="{StaticResource ToolReadOnlyBox}"
                                 Height="26" Margin="0,0,6,0" ToolTip="本机 payload.bin（点右侧文件夹按钮选择）"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="&#xE8B7;" Style="{StaticResource ToolIconButton}"
                                Click="BtnBrowsePayload_Click" ToolTip="选择本机 payload.bin"/>
                    </Grid>
                </HeaderedContentControl>

                <!-- 分组框：日志（撑满左列剩余高度） -->
                <HeaderedContentControl Grid.Row="1" Style="{StaticResource ToolGroup}" Header="日志">
                    <RichTextBox x:Name="TxtLog" Style="{StaticResource LogRichTextBox}"
                                 HorizontalScrollBarVisibility="Disabled"
                                 VerticalScrollBarVisibility="Auto">
                        <RichTextBox.Resources>
                            <!-- RichTextBox 的段落默认带上下外边距，会把日志行距撑开 -->
                            <Style TargetType="Paragraph">
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </RichTextBox.Resources>
                    </RichTextBox>
                </HeaderedContentControl>
            </Grid>

            <!-- ── 右列：分区管理（*，表格自己滚）+ 更多操作（折叠区，Auto） ── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 分组框：分区管理（保存路径 / 分区表 / 解析与提取 / 搜索）
                     参考稿里这一格**独占整个右列**：保存路径 → 表格 → 底部按钮行。
                     原来的「全选/取消全选」行被摘走（进折叠区），表格顶到保存路径下面。 -->
                <HeaderedContentControl Grid.Row="0" Style="{StaticResource ToolGroup}" Header="分区管理">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>   <!-- 保存路径行 -->
                            <RowDefinition Height="*" MinHeight="120"/>  <!-- 分区表：吃满剩余高度 -->
                            <RowDefinition Height="26"/>   <!-- 底部按钮行 -->
                        </Grid.RowDefinitions>

                        <!-- 保存路径：提取出来的 .img 落在这个目录（提取时不再弹目录对话框） -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="0"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="保存路径:" Style="{StaticResource ToolFieldLabel}"/>
                            <TextBox Grid.Column="1" x:Name="TxtSaveDir" Style="{StaticResource ToolReadOnlyBox}"
                                     Height="26" Margin="0,0,6,0"
                                     ToolTip="提取出来的分区镜像保存到哪个目录；空着时提取前会弹目录选择框"/>
                            <Button Grid.Column="2" Content="&#xE8B7;" Style="{StaticResource ToolIconButton}"
                                    Click="BtnPickSaveDir_Click" ToolTip="选择提取目录"/>
                        </Grid>

                        <!-- 分区表：勾选框 / # / 文件名 / 偏移地址 / 大小 -->
                        <DataGrid Grid.Row="1" x:Name="DgPartitions" Style="{StaticResource ThemedDataGrid}"
                                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                  SelectionMode="Extended" ToolTip="勾选要提取的分区，再点「提取文件」">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="34">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource ThemedCheckBox}" HorizontalAlignment="Center"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40"/>
                                <DataGridTextColumn Header="文件名" Binding="{Binding Name}" Width="180"/>
                                <DataGridTextColumn Header="偏移地址" Binding="{Binding OffsetText}" Width="110"/>
                                <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 底部按钮行：主操作在左，「搜索分区」是右端那枚独立胶囊（参考稿形态）。
                             输入框默认收起 —— 点胶囊才展开并聚焦；再点一次收起且清空过滤词。
                             它的 x:Name / TextChanged 没变，过滤逻辑一行没动。 -->
                        <Grid Grid.Row="2" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="0"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Content="解析固件" Style="{StaticResource ThemedPrimaryButton}"
                                        Click="BtnParsePayload_Click" Height="26" Margin="0,0,6,0"
                                        ToolTip="解析「本地」框里的 payload.bin，列出其中的分区"/>
                                <Button Content="提取文件" Style="{StaticResource ThemedFlatButton}"
                                        Click="BtnExtractSelected_Click" Height="26"
                                        ToolTip="把勾选的分区提取到「保存路径」"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBox x:Name="TxtPartSearch" Style="{StaticResource ThemedInputBox}"
                                         Width="130" Padding="8,3" Height="26" Margin="0,0,6,0" Visibility="Collapsed"
                                         TextChanged="TxtPartSearch_TextChanged" ToolTip="按分区名过滤表格"/>
                                <Button Content="搜索分区" Style="{StaticResource ThemedFlatButton}"
                                        Click="SearchToggle_Click" Tag="TxtPartSearch" Height="26"
                                        ToolTip="展开输入框，按分区名过滤表格"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </HeaderedContentControl>

                <!-- 折叠区：参考稿里没有这三样，收进来。功能一个不少，只是不在主视线上。 -->
                <Expander Grid.Row="1" Style="{StaticResource ToolFold}"
                          Header="更多操作">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="全选" Style="{StaticResource ThemedFlatButton}"
                                    Click="BtnSelectAll_Click" Height="26" Margin="0,0,6,0"/>
                            <Button Content="取消全选" Style="{StaticResource ThemedFlatButton}"
                                    Click="BtnDeselectAll_Click" Height="26" Margin="0,0,6,0"/>
                            <Button Content="提取全部" Style="{StaticResource ThemedFlatButton}"
                                    Click="BtnExtractAll_Click" Height="26"
                                    ToolTip="提取解析出来的全部分区"/>
                        </StackPanel>

                        <!-- 分组框：解析信息（细进度条 + 进度文字 + 解析摘要）
                             ⚠️ 这里的 ProgressBar 只是为兼容 code-behind 保留的（.cs 每个分区都写它的 Value），
                                页面级进度已由外壳 ③ 的通栏双进度条承担。 -->
                        <HeaderedContentControl Style="{StaticResource ToolGroup}" Header="解析信息">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="14"/>  <!-- 兼容保留的细进度条 -->
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ProgressBar Grid.Row="0" x:Name="ProgressBar" Style="{StaticResource RoundedProgressBar}" Value="0"/>
                                <TextBlock Grid.Row="1" x:Name="TxtProgress" Text="等待中" Style="{StaticResource ToolFieldValue}"
                                           Margin="0,6,0,0"/>
                                <TextBox Grid.Row="2" x:Name="TxtInfo" Style="{StaticResource ToolReadOnlyBox}" Margin="0,6,0,0"
                                         Text="-" ToolTip="最近一次解析的摘要（文件 / 分区数 / 总大小）"/>
                            </Grid>
                        </HeaderedContentControl>
                    </StackPanel>
                </Expander>
            </Grid>
        </Grid>
    </Grid>
</services:BasePage>
