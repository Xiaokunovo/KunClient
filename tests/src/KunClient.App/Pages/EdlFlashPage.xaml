<services:BasePage x:Class="KunFlashTool.App.Pages.EdlFlashPage"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:services="clr-namespace:KunFlashTool.App.Services">
    <!-- ⚠️ 本页无页内状态栏/页头：进度与状态一律上报 ShellStatus，由外壳 ③ 通栏双进度条 + ④ 分段状态栏承担。 -->
    <!-- ═══════════════════════════════════════════════════════════════════
         EDL（Qualcomm 9008）页 —— **2026-10-09 整套移植自 SWT-EDL 的 Qt 界面**。

         来源：`third_party/swt-edl/src/ui/MainWindow.cpp`（buildLeftCard / buildRightCard）；
         底层引擎是 C# 逐文件重写的 `KunFlashTool.Core.SwtEdl.*`（EdlWorker 编排）。
         版式按 SWT-EDL 的两列卡片复刻：

           左卡片                         右卡片
           ─────────────────────────      ─────────────────────────
           串口 [▾] □自动扫描  存储 [▾]     操作日志            □Debug [清空]
           ┌ 分区表（□｜分区名｜文件名｜大小｜状态）┐   ┌ 日志 ─────────────┐
           │                                      │   └───────────────────┘
           └──────────────────────────────────────┘   设备信息（3 列 × 4 行读数）
           [rawprogram XML 路径] [选择资料]            [ 连接设备后即可开始操作 ]
           [firehose 路径]  模式 [EDL ▾]               当前任务 0.0%  速率 0.00 MB/s
           [官方高通骁龙芯片（Qualcomm EDL）] [查找分区] 总体进度 0.0%  [重启设备][停止]
           □自动重启 □OPPO VIP □生成 XML □保护分区 □读取信息
           [读取分区表][读取版本][读取分区][擦除分区][写入分区]

         ⚠️ 与源界面的**取舍**（都不是功能缺失）：
           ① SWT-EDL 顶部的「快速操作 / 高级功能 / 辅助功能」与卡片内的「刷机界面 / 其他界面」
              四个按钮里，后三个在源程序里就是 `setEnabled(false)` 的占位，点不动也不显示任何东西 ——
              本页不再重复摆这些死按钮（外壳的菜单栏 + 页签区已经承担了导航）。
           ② 源界面的「操作日志」旁边是 checkable 的 QPushButton，这里用**复选框**表达同一个开关
              （WPF 里 Button 样式套不到 ToggleButton 上，用 CheckBox 才不会 XamlParseException）。
           ③ 进度条**不在此页画**：当前任务 / 总体进度统一上报外壳底部 ShellStatus 通栏双进度条，
              本页只保留「速率」读数与重启 / 停止按钮，避免与外壳重复。

         🔴 隐形契约（改这个页时不得破坏）：
            · TxtLog 的 x:Name 一个字不能改 —— BasePage.LogTarget / PageLog 按名字找日志框；
            · NotifyBar / NotifyIcon / NotifyText 三件套结构不可改 —— BasePage 靠名字弹提示；
            · 其余 x:Name 由 EdlFlashPage.xaml.cs 按名字写值 / 读值，改名即静默失效。
         ═══════════════════════════════════════════════════════════════════ -->
    <Grid Background="{DynamicResource Theme.BgTint}" Margin="{StaticResource Tool.PagePad}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="320"/>
        </Grid.RowDefinitions>

        <!-- 页面内通知条：BasePage 靠 FindName 取这三个名字，结构不可改 -->
        <Border x:Name="NotifyBar" Grid.Row="0" Visibility="Collapsed" CornerRadius="{StaticResource R.Control}"
                Padding="10,7" Margin="0,0,0,8"
                Background="{DynamicResource Theme.InfoBg}"
                BorderBrush="{DynamicResource Theme.Info}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="NotifyIcon" FontSize="12.5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="NotifyText" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ═══ 主区：左卡片（刷机操作） + 右卡片（日志 / 设备信息 / 进度） ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="0"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- ─────────────── 左卡片 ─────────────── -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <!-- 🔴 故意不用 ScrollViewer + StackPanel：StackPanel 只按内容收缩，窗口一高
                     卡片下半就空一截（2026-10-09 用户截图反馈）。改用 DockPanel ——
                     rawprogram XML 以下的整块操作区钉在卡片底部，省出来的高度全部给分区表。
                     ⚠️ Dock 底部对是**自下而上**堆叠的，所以声明顺序必须是：
                     按钮（最底）→ 选项行 → 芯片/查找分区 → firehose → rawprogram XML。 -->
                <DockPanel Margin="10" LastChildFill="True">

                    <!-- 串口 / 自动扫描 / 存储 -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="串口" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Style="{StaticResource ToolFieldLabel}"/>
                        <ComboBox Grid.Column="1" x:Name="CmbPort" Height="26" FontSize="11.5"
                                  Style="{StaticResource ThemedComboPill}"
                                  SelectionChanged="CmbPort_SelectionChanged"/>
                        <CheckBox Grid.Column="2" x:Name="ChkAutoScan" Content="自动扫描" Margin="8,0,0,0"
                                  VerticalAlignment="Center" Style="{StaticResource ThemedCheckBox}"
                                  Checked="ChkAutoScan_Changed" Unchecked="ChkAutoScan_Changed"/>
                        <TextBlock Grid.Column="4" Text="存储" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Style="{StaticResource ToolFieldLabel}"/>
                        <ComboBox Grid.Column="5" x:Name="CmbStorage" Width="82" Height="26" FontSize="11.5"
                                  Style="{StaticResource ThemedComboPill}"
                                  SelectionChanged="CmbStorage_SelectionChanged">
                            <ComboBoxItem Content="UFS" IsSelected="True"/>
                            <ComboBoxItem Content="eMMC"/>
                        </ComboBox>
                    </Grid>

                    <!-- 底部操作块（钉在卡片底部） -->
                    <WrapPanel DockPanel.Dock="Bottom">
                        <Button x:Name="BtnReadGpt" Content="读取分区表" Margin="0,0,6,6" Height="28" Padding="12,0" FontSize="11.5"
                                Style="{StaticResource ThemedFlatButton}" Click="BtnReadGpt_Click"/>
                        <Button x:Name="BtnReadVersion" Content="读取版本" Margin="0,0,6,6" Height="28" Padding="12,0" FontSize="11.5"
                                Style="{StaticResource ThemedFlatButton}" Click="BtnReadVersion_Click"/>
                        <Button x:Name="BtnBackup" Content="读取分区" Margin="0,0,6,6" Height="28" Padding="12,0" FontSize="11.5"
                                Style="{StaticResource ThemedFlatButton}" Click="BtnBackup_Click"/>
                        <Button x:Name="BtnErase" Content="擦除分区" Margin="0,0,6,6" Height="28" Padding="12,0" FontSize="11.5"
                                Style="{StaticResource ThemedFlatButton}" Click="BtnErase_Click"/>
                        <Button x:Name="BtnFlash" Content="写入分区" Margin="0,0,6,6" Height="28" Padding="14,0" FontSize="11.5"
                                Style="{StaticResource ThemedPrimaryButton}" Click="BtnFlash_Click"/>
                    </WrapPanel>

                    <!-- 选项行 -->
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
                        <CheckBox x:Name="ChkAutoReboot" Content="自动重启" Margin="0,0,10,0"
                                  Style="{StaticResource ThemedCheckBox}"
                                  ToolTip="读取或写入任务完成后自动重启到系统"/>
                        <CheckBox x:Name="ChkVip" Content="OPPO VIP" Margin="0,0,10,0"
                                  Style="{StaticResource ThemedCheckBox}"
                                  ToolTip="OPPO/一加授权维修通道：需要厂商签发的授权文件（digest + signature），执行 Digest → Verify → Sign → SHA-256 → Configure 序列。仅可用于你本人所有或已获授权维修的设备。"
                                  Checked="ChkVip_Changed" Unchecked="ChkVip_Changed"/>
                        <CheckBox x:Name="ChkGenerateXml" Content="生成 XML" Margin="0,0,10,0"
                                  Style="{StaticResource ThemedCheckBox}"
                                  ToolTip="回读所选分区后，按 LUN 生成可再次刷写的 rawprogram XML"/>
                        <CheckBox x:Name="ChkProtect" Content="保护分区" Margin="0,0,10,0"
                                  Style="{StaticResource ThemedCheckBox}"
                                  ToolTip="保护校准、基带指纹及 OPLUS NV 分区；写入和擦除时默认跳过"
                                  Checked="ChkProtect_Changed" Unchecked="ChkProtect_Changed"/>
                        <CheckBox x:Name="ChkReadInfo" Content="读取信息"
                                  Style="{StaticResource ThemedCheckBox}"
                                  ToolTip="读取 GPT 后自动解析系统版本、Android 版本与安全补丁"/>
                    </WrapPanel>

                    <!-- 芯片 / 查找分区 -->
                    <Grid DockPanel.Dock="Bottom" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" x:Name="CmbChipset" Height="26" FontSize="11.5"
                                  Style="{StaticResource ThemedComboPill}">
                            <ComboBoxItem Content="官方高通骁龙芯片（Qualcomm EDL）" IsSelected="True"/>
                        </ComboBox>
                        <Button Grid.Column="1" x:Name="BtnConnect" Content="查找分区" Margin="6,0,0,0" Height="26"
                                Padding="11,0" FontSize="11.5"
                                Style="{StaticResource ThemedFlatButton}" Click="BtnConnect_Click"/>
                    </Grid>

                    <!-- firehose / 模式 -->
                    <Grid DockPanel.Dock="Bottom" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtProgrammer" Height="26" FontSize="11.5"
                                 Style="{StaticResource ThemedInputBox}" VerticalContentAlignment="Center"
                                 MouseDoubleClick="TxtProgrammer_MouseDoubleClick"
                                 ToolTip="双击选择 firehose 文件（*.elf / *.mbn / *.melf）"/>
                        <TextBlock Grid.Column="1" Text="模式" VerticalAlignment="Center" Margin="6,0,6,0"
                                   Style="{StaticResource ToolFieldLabel}"/>
                        <ComboBox Grid.Column="2" x:Name="CmbMode" Width="82" Height="26" FontSize="11.5"
                                  Style="{StaticResource ThemedComboPill}">
                            <ComboBoxItem Content="EDL" IsSelected="True"/>
                        </ComboBox>
                    </Grid>

                    <!-- rawprogram XML / 选择资料 -->
                    <Grid DockPanel.Dock="Bottom" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtXmlPath" Height="26" FontSize="11.5" IsReadOnly="True"
                                 Style="{StaticResource ToolReadOnlyBox}" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Column="0" x:Name="TxtXmlHint" IsHitTestVisible="False" Margin="8,0,0,0"
                                   VerticalAlignment="Center" FontSize="11.5"
                                   Foreground="{DynamicResource Theme.TextTertiary}"
                                   Text="选择 rawprogram XML..."/>
                        <Button Grid.Column="1" Content="选择资料" Margin="6,0,0,0" Height="26" Padding="11,0" FontSize="11.5"
                                Style="{StaticResource ThemedFlatButton}" Click="BtnPickXml_Click"/>
                    </Grid>

                    <!-- 分区表：占满串口行与底部操作块之间的**全部**剩余高度
                         （□ ｜ 分区名 ｜ 文件名 ｜ 大小 ｜ 状态） -->
                    <Grid MinHeight="180">
                        <DataGrid x:Name="DgPartitions" Style="{StaticResource ThemedDataGrid}"
                                  MinHeight="180" SelectionMode="Single"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  MouseDoubleClick="DgPartitions_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="34">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource ThemedCheckBox}" HorizontalAlignment="Center"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Click="ChkPartition_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="分区名" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="Auto" IsReadOnly="True"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="Auto" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!-- 空态提示：表格为空时盖在上面（对应 SWT-EDL 的 emptyState）。 -->
                        <TextBlock x:Name="TxtEmptyState" IsHitTestVisible="False"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Theme.TextTertiary}"
                                   Text="选择 rawprogram XML 后，这里会显示分区镜像&#x0a;&#x0a;连接设备后可双击分区选择独立镜像"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ─────────────── 右卡片 ─────────────── -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <!-- 🔴 2026-10-10（用户截图反馈「把日志拉长，设备信息往下来一点」）：
                     由 ScrollViewer+StackPanel（日志写死 Height=210）改为 DockPanel + LastChildFill ——
                     日志块作为**最后一个子元素占满剩余高度**，设备信息 / 状态横幅 / 速率按钮钉在卡片底部，
                     于是窗口越高日志越长、设备信息随之下移（与左卡片分区表同一套 DockPanel 手法）。
                     参考源界面 buildRightCard：日志本就是 stretch 项（min 255 / max 280）。 -->
                <DockPanel Margin="10" LastChildFill="True">

                    <!-- 操作日志标题行 -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="操作日志" VerticalAlignment="Center" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}"/>
                        <CheckBox Grid.Column="1" x:Name="ChkDebugLog" Content="Debug" Height="24"
                                  VerticalAlignment="Center" Style="{StaticResource ThemedCheckBox}"
                                  ToolTip="开启后显示 Firehose 原始帧、命令及身份重试等完整日志"
                                  Checked="ChkDebugLog_Changed" Unchecked="ChkDebugLog_Changed"/>
                        <Button Grid.Column="2" x:Name="BtnClearLog" Content="清空" Margin="6,0,0,0" Height="24"
                                Padding="9,0" FontSize="11"
                                Style="{StaticResource ThemedFlatButton}" Click="BtnClearLog_Click"/>
                    </Grid>

                    <!-- 速率 + 重启 / 停止（先声明 = 最贴卡片底部；进度条由外壳 ShellStatus 通栏承担） -->
                    <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="TxtSpeed" Text="速率  0.00 MB/s"
                                   VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource Theme.TextSecondary}"/>
                        <Button Grid.Column="1" x:Name="BtnReboot" Content="重启设备" Margin="9,0,0,0"
                                Height="26" Padding="10,0" FontSize="11"
                                Style="{StaticResource ThemedFlatButton}" Click="BtnReboot_Click">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="MenuReboot">
                                    <MenuItem Header="重启到系统" Click="MenuRebootSystem_Click"/>
                                    <MenuItem Header="重启到 9008" Click="MenuRebootEdl_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Grid.Column="2" x:Name="BtnStop" Content="停止" Margin="6,0,0,0"
                                Height="26" Padding="12,0" FontSize="11"
                                Style="{StaticResource ThemedDangerButton}" Click="BtnStop_Click"/>
                    </Grid>

                    <!-- 状态横幅：连接设备后即可开始操作 -->
                    <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="10,7" CornerRadius="{StaticResource R.Control}"
                            Background="{DynamicResource Theme.SurfaceAlt}"
                            BorderBrush="{DynamicResource Theme.BorderSubtle}" BorderThickness="1">
                        <TextBlock x:Name="TxtStateBanner" Text="连接设备后即可开始操作" FontSize="11.5"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Theme.AccentText2}"/>
                    </Border>

                    <!-- 设备信息（3 列 × 4 行读数） -->
                    <Grid DockPanel.Dock="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="品牌" Style="{StaticResource ToolFieldLabel}"/>
                            <TextBlock x:Name="TxtBrand" Text="—" TextWrapping="Wrap" Style="{StaticResource ToolFieldValue}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="芯片" Style="{StaticResource ToolFieldLabel}"/>
                            <TextBlock x:Name="TxtChip" Text="—" TextWrapping="Wrap" Style="{StaticResource ToolFieldValue}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="4">
                            <TextBlock Text="CPUID" Style="{StaticResource ToolFieldLabel}"/>
                            <TextBlock x:Name="TxtCpuId" Text="—" TextWrapping="Wrap" Style="{StaticResource ToolFieldValue}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,6,0,0">
                            <TextBlock Text="用户区大小" Style="{StaticResource ToolFieldLabel}"/>
                            <TextBlock x:Name="TxtUserSize" Text="—" TextWrapping="Wrap" Style="{StaticResource ToolFieldValue}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,6,0,0">
                            <TextBlock Text="当前模式" Style="{StaticResource ToolFieldLabel}"/>
                            <TextBlock x:Name="TxtCurrentMode" Text="—" TextWrapping="Wrap" Style="{StaticResource ToolFieldValue}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,6,0,0">
                            <TextBlock Text="存储型号" Style="{StaticResource ToolFieldLabel}"/>
                            <TextBlock x:Name="TxtStorageModel" Text="—" TextWrapping="Wrap" Style="{StaticResource ToolFieldValue}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,6,0,0">
                            <TextBlock Text="设备名称" Style="{StaticResource ToolFieldLabel}"/>
                            <TextBlock x:Name="TxtDeviceName" Text="—" TextWrapping="Wrap" Style="{StaticResource ToolFieldValue}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,6,0,0">
                            <TextBlock Text="Android" Style="{StaticResource ToolFieldLabel}"/>
                            <TextBlock x:Name="TxtAndroid" Text="—" TextWrapping="Wrap" Style="{StaticResource ToolFieldValue}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="4" Margin="0,6,0,0">
                            <TextBlock Text="系统版本" Style="{StaticResource ToolFieldLabel}"/>
                            <TextBlock x:Name="TxtSysVersion" Text="—" TextWrapping="Wrap" Style="{StaticResource ToolFieldValue}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,6,0,0">
                            <TextBlock Text="安全补丁" Style="{StaticResource ToolFieldLabel}"/>
                            <TextBlock x:Name="TxtSecPatch" Text="—" TextWrapping="Wrap" Style="{StaticResource ToolFieldValue}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 设备信息标题（声明在表格之后 = 位于表格上方） -->
                    <TextBlock DockPanel.Dock="Bottom" Text="设备信息" Margin="0,10,0,6" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.TextPrimary}"/>

                    <!-- 操作日志：占满剩余高度（窗口越高日志越长；底限 140，避免小窗被挤没） -->
                    <Border Style="{StaticResource CardBorder}" MinHeight="140">
                        <RichTextBox x:Name="TxtLog" Style="{StaticResource LogRichTextBox}"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     IsReadOnly="True">
                            <RichTextBox.Resources>
                                <!-- 段落默认带上下外边距，会把日志行距撑开 -->
                                <Style TargetType="Paragraph">
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </RichTextBox.Resources>
                        </RichTextBox>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</services:BasePage>
