<services:BasePage x:Class="KunFlashTool.App.Pages.AppManagerPage"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:services="clr-namespace:KunFlashTool.App.Services">
    <!-- ═══════════════════════════════════════════════════════════════════
         应用管理 · 经典桌面工具箱版式（换肤改排）
         ───────────────────────────────────────────────────────────────────
         上一版是「单列分组框自上而下」；本页在 MainWindow 的页表里标了 OwnRail:true ——
         外壳共用左栏（Controls/DeviceLogRail）对本页整列让位，所以「设备信息 + 日志」
         必须由页面自己出，版式随之改成标准的两列（配方见 docs/ui-toolbox-skin.md）：
           ① 页根 = Grid + Theme.BgTint + Tool.PagePad（页签名「应用管理」就是标题）。
           ② 左列 316（与外壳左栏同宽，两者不会同时出现）：
                ·「设备信息」分组框 —— 本页自己不探测设备，读数与外壳左栏同源：
                  设备/模式 ← DeviceStateHub（谁探测谁汇报），任务/进度/状态 ← ShellStatus
                  （各操作的 PageLog.Section 已把任务名上报），由代码后置的
                  SyncRailDevice / SyncRailStatus 刷新（只做了加法）；
                ·「日志」分组框 —— TxtLog 占满左列剩余高度（从原单列尾部挪进左列）。
           ③ 右列 *：「应用列表」（搜索行 + DataGrid + 操作按钮行，表格用 * 行吃满剩余高度、
              表格自己滚）+「应用信息」（包名 / 版本 两行读数，从原单列挪到表格下方）。
           ④ 分组框自带 Margin="0,0,0,8"（ToolGroup 样式给的），页面里不再写间距魔法数；
              分组框内也不套 Padding（ToolGroup 模板已留 10,16,10,10）。
           ⑤ 外壳四层（菜单栏 / 页签 / 通栏双进度条 / 分段状态栏）由 MainWindow 承担，
              本页因此不再放 PageHeaderBar、页内进度条、页内状态栏；
              控件高度一律字面 26，间距一律字面 6/8/10（不引 StaticResource 参与复合字符串）。
         🔴 隐形契约（重构布局时不得破坏）：
            · TxtLog 的 x:Name 一个字不能改 —— BasePage.LogTarget / PageLog 按名字找日志框；
            · NotifyBar / NotifyIcon / NotifyText 三件套结构不可改 —— BasePage 靠名字弹提示；
            · LstApps 是 DataGrid，行数据是**包名字符串**（代码后置直接往 Items 里 Add），
              「包名」列靠 Binding="{Binding}" 显示行数据本身，列定义不能换；
            · TxtSearch / ChkShowSystem / TxtPackageName / TxtVersion 由各处理器直接读写；
              左栏新增的 TxtRail* 读数名只被本页 .cs 的同步方法引用。
         ═══════════════════════════════════════════════════════════════════ -->
    <Grid Background="{DynamicResource Theme.BgTint}" Margin="{StaticResource Tool.PagePad}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 主区地板 280：左列「设备信息 + 日志」至少要这么高才不挤 -->
            <RowDefinition Height="*" MinHeight="280"/>
        </Grid.RowDefinitions>

        <!-- 内联提示条：保留 NotifyBar / NotifyIcon / NotifyText 三个名字（BasePage 依赖这三个名字），
             外观是经典小提示条：浅蓝底 + 蓝描边；真正显示时由 Notify.Show 按成败覆写配色。 -->
        <Border x:Name="NotifyBar" Grid.Row="0" Visibility="Collapsed" CornerRadius="{StaticResource R.Control}"
                Padding="10,7" Margin="0,0,0,8"
                Background="{DynamicResource Theme.InfoBg}"
                BorderBrush="{DynamicResource Theme.Info}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="NotifyIcon" FontSize="12.5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="NotifyText" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ═══════════ 主区：左列（设备信息 + 日志） + 右列（应用列表 + 应用信息） ═══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 左列 316：与外壳左栏（DeviceLogRail）同宽 —— 两者不会同时出现 -->
                <ColumnDefinition Width="316"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- ── 左列：设备信息（Auto）+ 日志（*） ── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="140"/>
                </Grid.RowDefinitions>

                <!-- 分组框：设备信息（读数与外壳左栏同源：DeviceStateHub + ShellStatus，
                     由代码后置的 SyncRailDevice / SyncRailStatus 刷新 —— 本页不探测设备） -->
                <HeaderedContentControl Grid.Row="0" Style="{StaticResource ToolGroup}" Header="设备信息">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="序列号:" Style="{StaticResource ToolFieldLabel}"/>
                        <TextBlock x:Name="TxtRailDevice" Grid.Row="0" Grid.Column="1" Text="-" Style="{StaticResource ToolFieldValue}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="模式:" Style="{StaticResource ToolFieldLabel}"/>
                        <TextBlock x:Name="TxtRailMode" Grid.Row="0" Grid.Column="4" Text="-" Style="{StaticResource ToolFieldValue}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="任务:" Style="{StaticResource ToolFieldLabel}"/>
                        <TextBlock x:Name="TxtRailTask" Grid.Row="1" Grid.Column="1" Text="-" Style="{StaticResource ToolFieldValue}"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="进度:" Style="{StaticResource ToolFieldLabel}"/>
                        <TextBlock x:Name="TxtRailPercent" Grid.Row="1" Grid.Column="4" Text="0%" Style="{StaticResource ToolFieldValue}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="状态:" Style="{StaticResource ToolFieldLabel}"/>
                        <TextBlock x:Name="TxtRailHint" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
                                   Text="就绪" Style="{StaticResource ToolFieldValue}"/>
                    </Grid>
                </HeaderedContentControl>

                <!-- 分组框：日志（从原单列尾部挪进左列，占满剩余高度；本页的操作日志落在这里） -->
                <HeaderedContentControl Grid.Row="1" Style="{StaticResource ToolGroup}" Header="日志">
                    <RichTextBox x:Name="TxtLog" Style="{StaticResource LogRichTextBox}"
                                 HorizontalScrollBarVisibility="Disabled"
                                 VerticalScrollBarVisibility="Auto"
                                 IsReadOnly="True" IsUndoEnabled="False" IsDocumentEnabled="False">
                        <RichTextBox.Resources>
                            <!-- RichTextBox 的段落默认带上下外边距，会把日志行距撑开 -->
                            <Style TargetType="Paragraph">
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </RichTextBox.Resources>
                    </RichTextBox>
                </HeaderedContentControl>
            </Grid>

            <!-- ── 右列：应用列表（*，表格自己滚） + 应用信息（Auto） ── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="180"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ═══════════ 应用列表 ═══════════ -->
                <HeaderedContentControl Grid.Row="0" Style="{StaticResource ToolGroup}" Header="应用列表">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- 搜索行 -->
                            <RowDefinition Height="*"/>     <!-- 表格：占满剩余高度 -->
                            <RowDefinition Height="Auto"/>  <!-- 操作按钮行 -->
                        </Grid.RowDefinitions>

                        <!-- 搜索行：左标签 + 输入框 + 搜索按钮 + 「显示系统应用」勾选框 -->
                        <Grid Grid.Row="0" Height="26" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="搜索应用" Style="{StaticResource ToolFieldLabel}"/>
                            <TextBox Grid.Column="1" x:Name="TxtSearch" Style="{StaticResource ThemedInputBox}"
                                     Padding="8,3" Height="26" Margin="0,0,6,0" TextChanged="TxtSearch_TextChanged"/>
                            <Button Grid.Column="2" Content="搜索" Style="{StaticResource ThemedPrimaryButton}"
                                    Click="BtnSearch_Click" Height="26" Margin="0,0,10,0"/>
                            <CheckBox Grid.Column="3" x:Name="ChkShowSystem" Content="显示系统应用"
                                      Style="{StaticResource ThemedCheckBox}" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 应用列表：表格（灰表头 + 全网格线 + 24px 行高）。
                             ⚠️ 代码后置往 LstApps.Items 里放的是**包名字符串**（见 AppManagerPage.xaml.cs），
                                所以这一列用 Binding="{Binding}" 直接显示行数据本身，列定义不能换；
                                列宽保持原值不动（红线：只统一样式）；
                                CanUserSortColumns 关掉：空路径的列排不了序，原来 ListBox 也没有排序，行为一致。 -->
                        <DataGrid Grid.Row="1" x:Name="LstApps" Style="{StaticResource ThemedDataGrid}"
                                  IsReadOnly="True" CanUserSortColumns="False" MinHeight="90"
                                  SelectionChanged="LstApps_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="包名" Binding="{Binding}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 操作按钮行：沿用原有 5 个按钮（冻结 / 解冻 / 提取APK / 清除数据 / 卸载应用），只换排版与高度 -->
                        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="冻结应用" Style="{StaticResource ThemedFlatButton}" Click="BtnFreezeApp_Click"
                                    Height="26" Margin="0,0,6,0"/>
                            <Button Content="解冻应用" Style="{StaticResource ThemedFlatButton}" Click="BtnUnfreezeApp_Click"
                                    Height="26" Margin="0,0,6,0"/>
                            <Button Content="提取APK" Style="{StaticResource ThemedFlatButton}" Click="BtnExtractApk_Click"
                                    Height="26" Margin="0,0,6,0"/>
                            <Button Content="清除数据" Style="{StaticResource ThemedFlatButton}" Click="BtnClearData_Click"
                                    Height="26" Margin="0,0,6,0"/>
                            <Button Content="卸载应用" Style="{StaticResource ThemedFlatButton}" Click="BtnUninstallApp_Click"
                                    Height="26"/>
                        </WrapPanel>
                    </Grid>
                </HeaderedContentControl>

                <!-- ═══════════ 应用信息 ═══════════
                     选中应用后由代码写入包名 / 版本（经典「标签: 值」两列读数）。 -->
                <HeaderedContentControl Grid.Row="1" Style="{StaticResource ToolGroup}" Header="应用信息">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="包名:" Style="{StaticResource ToolFieldLabel}"/>
                        <TextBlock x:Name="TxtPackageName" Grid.Row="0" Grid.Column="1" Text="-"
                                   Height="26" Style="{StaticResource ToolFieldValue}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="版本:" Style="{StaticResource ToolFieldLabel}"/>
                        <TextBlock x:Name="TxtVersion" Grid.Row="2" Grid.Column="1" Text="-"
                                   Height="26" Style="{StaticResource ToolFieldValue}"/>
                    </Grid>
                </HeaderedContentControl>
            </Grid>
        </Grid>
    </Grid>
</services:BasePage>
