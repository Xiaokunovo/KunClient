<services:BasePage x:Class="KunFlashTool.App.Pages.CloudDriverPage"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:services="clr-namespace:KunFlashTool.App.Services">
    <!-- 云端驱动：清单来自服务端 /api/packages/drivers（目录即清单），
         下载落到 %LOCALAPPDATA%\KunClient\drivers，zip 自动展开。
         ⚠️ 刻意不自动运行 .exe 安装器 —— 装驱动会动系统驱动库，
         交给用户在文件夹里自己双击，避免"点了下载结果静默改系统"。

         工具箱皮肤（配方见 docs/ui-toolbox-skin.md）：
         ① 页头标题栏已删 —— 页签名「云端驱动」就是标题。
         ② 页面根 Grid 画底色 Theme.BgTint + 字面页边距 10,10,10,8。
         ③ 本页**没有日志**（无 TxtLog，代码后置也从未引用过）→ 不做两列，
            一列分组框自上而下：「云端驱动列表」+「下载」。
         ④ 分组框内部不再套带圆角 Border（圆角与 1px 描边由 ToolGroup 模板负责），
            原来那行 SectionHeader 标题行由分组框 Header 承担。
         ⑤ 控件统一 Height="26"；间距一律字面数字（6/8/10）；
            颜色一律 DynamicResource Theme.*，不写死十六进制。

         ℹ️ 页内进度条：页内进度条已由外壳 ③ 承担，保留仅为兼容 code-behind。
            PrgDownload（.xaml.cs 里 4 处：Value=0 / 读进度 / 100 / 取消）不能删，
            所以收进「下载」分组框继续渲染；真实进度同时上报 ShellStatus
            （外壳底部通栏双进度条 + 分段状态栏，见 .xaml.cs 的 ShellStatus.Report）。
            另：原任务描述说本页有 2 个页内进度条，实际只有 PrgDownload 一个，
            第二个是纯文本读数 TxtProgress（非 ProgressBar），一并保留。

         ⚠️ 契约（重构布局时不得破坏）：
            1. NotifyBar / NotifyIcon / NotifyText 三个 x:Name 不能改（BasePage 靠 FindName 取，
               外观与参考页同款：InfoBg 底 + Info 描边，Padding 10,7）；
            2. TxtEmpty 与 DgDrivers 互斥显隐由 SetEmpty 写死在代码里，XAML 只给初始态；
            3. Click / SelectionChanged 处理器名一字未改。 -->
    <Grid Background="{DynamicResource Theme.BgTint}" Margin="10,10,10,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="320" />
        </Grid.RowDefinitions>

        <!-- 页面内通知条：BasePage 靠 FindName 取这三个名字，结构不可改 -->
        <Border x:Name="NotifyBar" Grid.Row="0" Visibility="Collapsed" CornerRadius="{StaticResource R.Control}"
                Padding="10,7" Margin="0,0,0,8"
                Background="{DynamicResource Theme.InfoBg}"
                BorderBrush="{DynamicResource Theme.Info}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="NotifyIcon" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="NotifyText" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 一列分组框：内容较高，整页带一个 ScrollViewer（VerticalScrollBarVisibility=Auto） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- 分组框：云端驱动列表（顶部一行「刷新列表」右对齐 + 空态提示 + 列表） -->
                <HeaderedContentControl Style="{StaticResource ToolGroup}" Header="云端驱动列表">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                            <Button x:Name="BtnRefresh" Content="刷新列表" Style="{StaticResource ThemedFlatButton}"
                                    Click="BtnRefresh_Click" Height="26" />
                        </StackPanel>

                        <TextBlock x:Name="TxtEmpty" Text="正在从服务器获取驱动列表…" Style="{StaticResource EmptyHint}"
                                   Margin="0,8,0,8" Visibility="Collapsed" />

                        <DataGrid x:Name="DgDrivers" Style="{StaticResource ThemedDataGrid}" AutoGenerateColumns="False"
                                  Height="300" IsReadOnly="True" SelectionMode="Single"
                                  SelectionChanged="DgDrivers_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="90" />
                                <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedText}" Width="130" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </HeaderedContentControl>

                <!-- 分组框：下载（选中项读数 + 进度 + 下载/打开目录） -->
                <HeaderedContentControl Style="{StaticResource ToolGroup}" Header="下载">
                    <StackPanel>
                        <!-- 选中项读数：两列键值网格（Auto + *），行高 26 字面数 -->
                        <Grid Height="26" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="已选:" Style="{StaticResource ToolFieldLabel}" />
                            <TextBlock Grid.Column="1" x:Name="TxtSelected" Text="未选择驱动"
                                       Style="{StaticResource ToolFieldValue}" />
                        </Grid>

                        <!-- 页内进度条已由外壳 ③ 承担，保留仅为兼容 code-behind（见文件头注释） -->
                        <ProgressBar x:Name="PrgDownload" Style="{StaticResource RoundedProgressBar}"
                                     Minimum="0" Maximum="100" Value="0" Margin="0,0,0,6" />
                        <TextBlock x:Name="TxtProgress" Text="" FontSize="11"
                                   Foreground="{DynamicResource Theme.TextTertiary}" Margin="0,0,0,10" />

                        <WrapPanel>
                            <Button x:Name="BtnDownload" Content="下载所选" Style="{StaticResource ThemedPrimaryButton}"
                                    Click="BtnDownload_Click" IsEnabled="False" Height="26" Margin="0,0,8,0" />
                            <Button Content="驱动文件夹" Style="{StaticResource ThemedFlatButton}"
                                    Click="BtnOpenFolder_Click" Height="26" />
                        </WrapPanel>

                        <TextBlock Text="下载位置：%LOCALAPPDATA%\KunClient\drivers，zip 会自动解压到同名文件夹。"
                                   FontSize="11" Foreground="{DynamicResource Theme.TextTertiary}" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</services:BasePage>
