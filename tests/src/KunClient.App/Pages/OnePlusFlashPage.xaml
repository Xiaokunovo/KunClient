<services:BasePage x:Class="KunFlashTool.App.Pages.OnePlusFlashPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:KunFlashTool.App.Services">
    <!-- ⚠️ 页内进度条（ProgressBar）已由外壳 ③ 承担，
         保留仅为兼容 code-behind（.cs 按名字写 Value / Text），删除需同步改 .cs。
         排版上已收进对应分组框，做成细条 + ToolFieldValue 文字，不再是页面级进度条。 -->
    <!-- ═══════════════════════════════════════════════════════════════════
         欧加线刷（OPPO / OnePlus / realme）—— 工具箱版式（照 ui-toolbox-skin.md 配方）
         ───────────────────────────────────────────────────────────────────
         ① 页头删除：<ctrl:PageHeaderBar/> 去掉，页签名「欧加线刷」就是标题。
         ② 页面根改成 Grid（Background=Theme.BgTint + Margin=Tool.PagePad）。
         ③ 两列：左 316（本页在 MainWindow 页表里标了 OwnRail:true，外壳共用左栏让位，
            所以左列由页面自己出）：「设备信息」+「刷写进度」+「日志」三个分组框 ——
            设备信息读数与外壳左栏同源（设备/模式 ← DeviceStateHub，任务/进度/状态 ←
            ShellStatus，由代码后置 SyncRailDevice / SyncRailStatus 刷新，只做了加法）；
            右 * = 本地文件 / 云端刷写 / 刷写操作 / AB 分区刷写 / Payload（五个操作分组框）。
         ④ 6 张 CardBorder → 分组框 HeaderedContentControl + ToolGroup：卡片标题变 Header，
            分组框内不再套 Padding（ToolGroup 模板已留 10,16,10,10）。
         ⑤ 进度/状态不再由本页画底部条：上报 ShellStatus（外壳底部双进度条 + 分段状态栏）。
         ⑥ 硬规矩：x:Name / Click / 绑定路径一字未改；右列内容高，右列自带一个 ScrollViewer。
         ═══════════════════════════════════════════════════════════════════ -->
    <Grid Background="{DynamicResource Theme.BgTint}" Margin="{StaticResource Tool.PagePad}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="320"/>
        </Grid.RowDefinitions>

        <!-- 页面内通知条：BasePage 靠 FindName 取这三个名字，结构不可改（经典外观：InfoBg + Info 描边） -->
        <Border x:Name="NotifyBar" Grid.Row="0" Visibility="Collapsed" CornerRadius="{StaticResource R.Control}"
                Padding="10,7" Margin="0,0,0,8"
                Background="{DynamicResource Theme.InfoBg}"
                BorderBrush="{DynamicResource Theme.Info}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="NotifyIcon" FontSize="12.5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="NotifyText" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ═══ 主区：左列（设备信息 + 进度读数 + 日志） + 右列（操作分组框） ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 左列 316：与外壳左栏（DeviceLogRail）同宽 —— 两者不会同时出现 -->
                <ColumnDefinition Width="316"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- ── 左列：设备信息（Auto）+ 刷写进度（Auto）+ 日志（*） ── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="120"/>
                </Grid.RowDefinitions>

                <!-- 分组框：设备信息（读数与外壳左栏同源：DeviceStateHub + ShellStatus，
                     由代码后置的 SyncRailDevice / SyncRailStatus 刷新 —— 本页自己不探测设备） -->
                <HeaderedContentControl Grid.Row="0" Style="{StaticResource ToolGroup}" Header="设备信息">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="24" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="序列号:" Style="{StaticResource ToolFieldLabel}" />
                        <TextBlock x:Name="TxtRailDevice" Grid.Row="0" Grid.Column="1" Text="-" Style="{StaticResource ToolFieldValue}" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="模式:" Style="{StaticResource ToolFieldLabel}" />
                        <TextBlock x:Name="TxtRailMode" Grid.Row="0" Grid.Column="4" Text="-" Style="{StaticResource ToolFieldValue}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="任务:" Style="{StaticResource ToolFieldLabel}" />
                        <TextBlock x:Name="TxtRailTask" Grid.Row="1" Grid.Column="1" Text="-" Style="{StaticResource ToolFieldValue}" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="进度:" Style="{StaticResource ToolFieldLabel}" />
                        <TextBlock x:Name="TxtRailPercent" Grid.Row="1" Grid.Column="4" Text="0%" Style="{StaticResource ToolFieldValue}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="状态:" Style="{StaticResource ToolFieldLabel}" />
                        <TextBlock x:Name="TxtRailHint" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
                                   Text="就绪" Style="{StaticResource ToolFieldValue}" />
                    </Grid>
                </HeaderedContentControl>

                <!-- 进度/状态读数：原来的进度条与状态文字从「刷写操作」卡里挪到这里，
                     和日志一起构成参考稿的左列；刷写按钮仍留在右侧「刷写操作」分组框。
                     ProgressBar 已压成细条：页面级进度条由外壳 ③ 负责，这里只做兼容读数。 -->
                <HeaderedContentControl Grid.Row="1" Style="{StaticResource ToolGroup}" Header="刷写进度">
                    <StackPanel>
                        <ProgressBar x:Name="ProgressBar" Style="{StaticResource RoundedProgressBar}"
                                     Height="6" Value="0"/>
                        <TextBlock x:Name="TxtProgress" Text="就绪" Style="{StaticResource ToolFieldValue}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Grid.Row="2" Style="{StaticResource ToolGroup}" Header="日志">
                    <RichTextBox x:Name="TxtLog" Style="{StaticResource LogRichTextBox}"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 IsReadOnly="True">
                        <RichTextBox.Resources>
                            <!-- 段落默认带上下外边距，会把日志行距撑开 -->
                            <Style TargetType="Paragraph">
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </RichTextBox.Resources>
                    </RichTextBox>
                </HeaderedContentControl>
            </Grid>

            <!-- ── 右列：操作分组框（内容高，右列自己滚） ── -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- 分组框：本地文件（路径 + 浏览图标钮 + 格式说明） -->
                    <HeaderedContentControl Style="{StaticResource ToolGroup}" Header="本地文件">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TxtLocalFile" Style="{StaticResource ThemedInputBox}"
                                         Margin="0,0,6,0"/>
                                <Button Grid.Column="1" Content="&#xE8B7;" Style="{StaticResource ToolIconButton}"
                                        Click="BtnBrowseLocal_Click"
                                        ToolTip="选择本地刷写包（OFP / OPS / ozip / payload.bin）"/>
                            </Grid>
                            <TextBlock Text="支持 OFP / OPS / ozip / payload.bin" FontSize="11"
                                       Foreground="{DynamicResource Theme.TextTertiary}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </HeaderedContentControl>

                    <!-- 分组框：云端刷写（下载链接 + 开始下载） -->
                    <HeaderedContentControl Style="{StaticResource ToolGroup}" Header="云端刷写">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="0"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtCloudUrl" Style="{StaticResource ThemedInputBox}"
                                     Margin="0,0,8,0" Text="输入ROM下载链接"/>
                            <Button Grid.Column="1" Content="开始下载" Style="{StaticResource ThemedPrimaryButton}"
                                    Click="BtnDownloadCloud_Click"/>
                        </Grid>
                    </HeaderedContentControl>

                    <!-- 分组框：刷写操作（刷写模式二选一 + 开始/停止） -->
                    <HeaderedContentControl Style="{StaticResource ToolGroup}" Header="刷写操作">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="刷写模式" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Theme.TextSecondary}" Margin="0,0,10,0"/>
                                <RadioButton x:Name="RbFullPackage" Content="完整包" GroupName="OplusMode" IsChecked="True"
                                             FontSize="12" Foreground="{DynamicResource Theme.TextPrimary}" Cursor="Hand"
                                             VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <RadioButton x:Name="RbAfterSale" Content="售后刷写" GroupName="OplusMode"
                                             FontSize="12" Foreground="{DynamicResource Theme.TextPrimary}" Cursor="Hand"
                                             VerticalAlignment="Center"/>
                            </StackPanel>
                            <WrapPanel>
                                <Button Content="开始刷写" Style="{StaticResource ThemedPrimaryButton}"
                                        Click="BtnStartFlash_Click" Margin="0,0,8,0"/>
                                <Button Content="停止刷写" Style="{StaticResource ThemedFlatButton}"
                                        Click="BtnStopFlash_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </HeaderedContentControl>

                    <!-- 分组框：AB 分区刷写（三个独立小操作压成一行按钮带） -->
                    <HeaderedContentControl Style="{StaticResource ToolGroup}" Header="AB 分区刷写">
                        <WrapPanel>
                            <Button Content="FastbootD" Style="{StaticResource ThemedFlatButton}"
                                    Click="BtnFastbootD_Click" Margin="0,0,8,0"/>
                            <Button Content="格式化数据" Style="{StaticResource ThemedFlatButton}"
                                    Click="BtnFormatData_Click" Margin="0,0,8,0"/>
                            <Button Content="擦除 FRP" Style="{StaticResource ThemedFlatButton}"
                                    Click="BtnEraseFrp_Click"
                                    ToolTip="清除出厂重置保护（设备防盗机制）。执行前需确认设备归属，仅限本人所有或已获授权的设备。"/>
                        </WrapPanel>
                    </HeaderedContentControl>

                    <!-- 分组框：Payload -->
                    <HeaderedContentControl Style="{StaticResource ToolGroup}" Header="Payload">
                        <WrapPanel>
                            <Button Content="解压 Payload" Style="{StaticResource ThemedPrimaryButton}"
                                    Click="BtnExtractPayload_Click"/>
                        </WrapPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</services:BasePage>
