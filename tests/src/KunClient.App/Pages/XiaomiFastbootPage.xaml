<services:BasePage x:Class="KunFlashTool.App.Pages.XiaomiFastbootPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:KunFlashTool.App.Services">
    <!-- ⚠️ 页内进度条（PrgFlash）已由外壳 ③ 承担，
         保留仅为兼容 code-behind（.cs 按名字写 Value / IsIndeterminate），删除需同步改 .cs。
         排版上已收进「刷写」分组框，做成细条 + ToolFieldValue 文字，不再是页面级进度条。 -->
    <!-- ═══════════════════════════════════════════════════════════════════
         小米线刷（类 MiFlash · Fastboot 线刷包全自动刷写）—— 工具箱版式
         ───────────────────────────────────────────────────────────────────
         ① 页头删除：<ctrl:PageHeaderBar/> 去掉，页签名「小米线刷」就是标题。
         ② 页面根改成 Grid（Background=Theme.BgTint + Margin=Tool.PagePad）。
         ③ 两列：左 316（本页在 MainWindow 页表里标了 OwnRail:true，外壳共用左栏让位，
            所以左列由页面自己出）：「设备信息」+「日志」两个分组框 ——「设备信息」就是
            原来的「设备」卡（TxtDeviceInfo 由代码写值 + 「检测设备」按钮），检测成功后
            代码已把结论广播给 DeviceStateHub / ShellStatus，外壳状态栏同享；
            右 * = 「线刷包」+「刷写」两个主操作分组框。
         ④ 4 张 CardBorder → 分组框 HeaderedContentControl + ToolGroup：卡片标题变 Header，
            分组框内不再套 Padding（ToolGroup 模板已留 10,16,10,10）。
            字号只留三档：分组框标题 12.5（样式自带）/ 正文 12 / 等宽读数 11。
         ⑤ 进度/状态不再由本页画底部条：PrgFlash 的百分比同时上报 ShellStatus，由外壳底部
            双进度条 + 分段状态栏显示；设备探测结果顺带广播给 DeviceStateHub（外壳状态栏用）。
         ⑥ 硬规矩：x:Name / Click / TextChanged / 绑定路径一字未改；右列自带 ScrollViewer。
         ═══════════════════════════════════════════════════════════════════ -->
    <Grid Background="{DynamicResource Theme.BgTint}" Margin="{StaticResource Tool.PagePad}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="320"/>
        </Grid.RowDefinitions>

        <!-- 页面内通知条：BasePage 靠 FindName 取这三个名字，结构不可改（经典外观：InfoBg + Info 描边） -->
        <Border x:Name="NotifyBar" Grid.Row="0" Visibility="Collapsed" CornerRadius="{StaticResource R.Control}"
                Padding="10,7" Margin="0,0,0,8"
                Background="{DynamicResource Theme.InfoBg}"
                BorderBrush="{DynamicResource Theme.Info}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="NotifyIcon" FontSize="12.5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="NotifyText" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ═══ 主区：左列（设备信息 + 日志） + 右列（线刷包 / 刷写） ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 左列 316：与外壳左栏（DeviceLogRail）同宽 —— 两者不会同时出现 -->
                <ColumnDefinition Width="316"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- ── 左列：设备信息（Auto）+ 日志（*） ── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="140"/>
                </Grid.RowDefinitions>

                <!-- 分组框：设备信息（原「设备」卡整块挪进左列，成为参考稿左列的信息块；
                     TxtDeviceInfo 是一整段等宽读数 —— 代码后置按「序列号 X ｜ 机型 Y ｜ …」
                     写整串文字，不能拆成多行标签:值） -->
                <HeaderedContentControl Grid.Row="0" Style="{StaticResource ToolGroup}" Header="设备信息">
                    <StackPanel>
                        <TextBlock x:Name="TxtDeviceInfo"
                                   Text="未检测 · 请进 Fastboot（关机按住 音量- 插线）后点「检测设备」"
                                   FontFamily="{StaticResource F.Mono}" FontSize="11" LineHeight="16"
                                   Foreground="{DynamicResource Theme.TextSecondary}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <Button x:Name="BtnDetectDevice" Content="检测设备" Style="{StaticResource ThemedFlatButton}"
                                    Click="BtnDetectDevice_Click" Margin="0,0,8,0"/>
                        </WrapPanel>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Grid.Row="1" Style="{StaticResource ToolGroup}" Header="日志">
                    <RichTextBox x:Name="TxtLog" Style="{StaticResource LogRichTextBox}"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 IsReadOnly="True">
                        <RichTextBox.Resources>
                            <!-- 段落默认带上下外边距，会把日志行距撑开 -->
                            <Style TargetType="Paragraph">
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </RichTextBox.Resources>
                    </RichTextBox>
                </HeaderedContentControl>
            </Grid>

            <!-- ── 右列：主操作（内容高，右列自己滚） ── -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- 分组框：线刷包（ROM 目录 + 浏览图标钮 + 解压 .tgz；检测结果 + 重新检测） -->
                    <HeaderedContentControl Style="{StaticResource ToolGroup}" Header="线刷包">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ROM 目录" Style="{StaticResource ToolFieldLabel}"/>
                                <!-- 只读展示框：路径这类不可编辑的读数走 ToolReadOnlyBox -->
                                <TextBox Grid.Column="1" x:Name="TxtRomPath" Style="{StaticResource ToolReadOnlyBox}"
                                         Margin="0,0,6,0" IsReadOnly="True" TextChanged="TxtRomPath_TextChanged"/>
                                <Button Grid.Column="2" x:Name="BtnBrowseFolder" Content="&#xE8B7;"
                                        Style="{StaticResource ToolIconButton}" Click="BtnBrowseFolder_Click"
                                        Margin="0,0,6,0"
                                        ToolTip="浏览线刷包目录（根目录需含 flash_all.bat）"/>
                                <Button Grid.Column="3" x:Name="BtnBrowseTgz" Content="解压"
                                        Style="{StaticResource ThemedFlatButton}" Click="BtnBrowseTgz_Click"/>
                            </Grid>

                            <!-- 检测结果一行说明：11 号次要色（与参考稿的「分组内说明行」同档） -->
                            <TextBlock x:Name="TxtRomInfo"
                                       Text="请选择线刷包目录（需含 flash_all.bat），或选 .tgz 自动解压"
                                       FontSize="11" Foreground="{DynamicResource Theme.TextTertiary}"
                                       TextWrapping="Wrap" Margin="0,6,0,8"/>

                            <WrapPanel>
                                <Button x:Name="BtnRescan" Content="重新检测" Style="{StaticResource ThemedFlatButton}"
                                        Click="BtnRescan_Click" Margin="0,0,8,0"/>
                            </WrapPanel>
                        </StackPanel>
                    </HeaderedContentControl>

                    <!-- 分组框：刷写（方式下拉 + 进度 + 阶段读数 + 开始/停止） -->
                    <HeaderedContentControl Style="{StaticResource ToolGroup}" Header="刷写">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="刷写方式" Style="{StaticResource ToolFieldLabel}"/>
                                <ComboBox Grid.Column="1" x:Name="CmbScript" Style="{StaticResource ThemedComboPill}"
                                          Height="26" FontSize="11"
                                          SelectedIndex="0" ToolTip="与 MiFlash 三档对应：clean all / save user data / clean all and lock">
                                    <ComboBoxItem Content="全部清除（flash_all.bat）"/>
                                    <ComboBoxItem Content="保留用户数据（flash_all_except_storage.bat）"/>
                                    <ComboBoxItem Content="全部清除并回锁（flash_all_lock.bat）"/>
                                </ComboBox>
                            </Grid>

                            <!-- 页内进度条：已收进本框并压成细条（Height=6）。页面级进度条由外壳 ③ 负责，
                                 PrgFlash 保留仅为兼容 code-behind（.cs 按名字写 Value / IsIndeterminate）。 -->
                            <ProgressBar x:Name="PrgFlash" Style="{StaticResource RoundedProgressBar}"
                                         Height="6" Maximum="100" Value="0" Margin="0,0,0,6"/>

                            <!-- 阶段读数：左边是阶段描述（正文 12），右边是百分比（等宽 11，数字对齐） -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="TxtStage" Text="空闲" FontSize="12"
                                           Foreground="{DynamicResource Theme.TextSecondary}"
                                           Margin="0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" x:Name="TxtPct" Text="0%" FontFamily="{StaticResource F.Mono}"
                                           FontSize="11" Foreground="{DynamicResource Theme.TextSecondary}"
                                           VerticalAlignment="Center" Margin="0"/>
                            </Grid>

                            <WrapPanel>
                                <Button x:Name="BtnStart" Content="开始刷写" Style="{StaticResource ThemedPrimaryButton}"
                                        Click="BtnStart_Click" Margin="0,0,8,0"/>
                                <Button x:Name="BtnStop" Content="停止" Style="{StaticResource ThemedDangerButton}"
                                        Click="BtnStop_Click" IsEnabled="False"/>
                            </WrapPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</services:BasePage>
