<services:BasePage x:Class="KunFlashTool.App.Pages.CommandConsolePage"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:services="clr-namespace:KunFlashTool.App.Services">
    <!-- 命令窗口：所有命令都交给 Windows 自带的 cmd.exe 执行，
         PATH 里注入本工具自带的 platform-tools 目录，所以 adb / fastboot 可以直接敲。

         工具箱皮肤（配方见 docs/ui-toolbox-skin.md）：
         ① 页头标题栏已删 —— 页签名「命令行」就是标题；页内也没有进度条与状态栏
            （外壳 ③ 通栏双进度条 + ④ 分段状态栏承担，执行期间向 ShellStatus 上报任务名）。
         ② 页面根 Grid 画底色 Theme.BgTint（全局「界面透明」改的就是它的 alpha）。
         ③ 输出区 = LogRichTextBox（等宽 F.Mono + 只读），不套带圆角 Border ——
            边框由 ToolGroup 模板画；日志框本身 BorderThickness=0。
         ④ 可编辑的输入行**刻意不加多余装饰**：只有一个 `>` 提示符 + 前缀下拉 + 输入框 + 执行，
            没有额外图标 / 角标 / 包裹 Border。
         ⑤ 控件统一 Height="26"；间距一律字面数字（6/8/10）；
            颜色一律 DynamicResource Theme.*，不写死十六进制。
         ⑥ 输出与命令历史在同一个分组框里（历史仍由输入框的 ↑/↓ 翻，功能未变）。

         ⚠️ 契约（重构布局时不得破坏）：
            1. NotifyBar / NotifyIcon / NotifyText 三个 x:Name 不能改（BasePage.ShowSuccess /
               ShowError 靠 FindName("NotifyBar") 弹提示）；
            2. 本页**没有也不需要** TxtLog —— 输出区 TxtConsole 就是日志（BasePage 的 LogTarget
               按 FindName("TxtLog") 找，找不到就是 null，代码后置从未引用过 TxtLog）。
               页面自带输出名 TxtConsole 一律不改名。 -->
    <Grid Background="{DynamicResource Theme.BgTint}" Margin="10,10,10,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="320" />
        </Grid.RowDefinitions>

        <!-- 页面内通知条：保留 NotifyBar / NotifyIcon / NotifyText 三个名字（BasePage 依赖），
             结构必须是 Border > StackPanel > TextBlock#NotifyIcon / #NotifyText。 -->
        <Border x:Name="NotifyBar" Grid.Row="0" Visibility="Collapsed" CornerRadius="{StaticResource R.Control}"
                Padding="10,7" Margin="0,0,0,8"
                Background="{DynamicResource Theme.InfoBg}"
                BorderBrush="{DynamicResource Theme.Info}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="NotifyIcon" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="NotifyText" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- ═══════════ 命令窗口（输出 + 命令行，同一个分组框） ═══════════ -->
        <HeaderedContentControl Grid.Row="1" Style="{StaticResource ToolGroup}" Header="命令窗口">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />      <!-- 输出区：占满剩余高度，自己滚动 -->
                    <RowDefinition Height="Auto" />   <!-- 命令行输入行 -->
                    <RowDefinition Height="Auto" />   <!-- 快捷按钮行 -->
                    <RowDefinition Height="Auto" />   <!-- 提示行 -->
                </Grid.RowDefinitions>

                <!-- 输出区：LogRichTextBox 自带 F.Mono 等宽 + IsReadOnly + 无边框，
                     这里只补一句显式只读（本轮不删任何属性，语义也不变）。 -->
                <RichTextBox Grid.Row="0" x:Name="TxtConsole" Style="{StaticResource LogRichTextBox}"
                             MinHeight="160" IsReadOnly="True" IsUndoEnabled="False" IsDocumentEnabled="False"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled" />

                <!-- 命令行：`>` 提示符 + 前缀下拉(adb/fastboot/原样执行) + 输入框（回车执行、↑/↓ 翻历史） + 执行
                     行高 26 写字面数：Tool.RowHeight 是 sys:Double，Grid.Height 用它没问题，
                     但放进 RowDefinition.Height（GridLength）会运行期抛，所以这里一律字面 26。 -->
                <Grid Grid.Row="1" Height="26" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="&gt;" FontFamily="{StaticResource F.Mono}" FontSize="12"
                               FontWeight="Bold" Foreground="{DynamicResource Theme.Accent}"
                               VerticalAlignment="Center" Margin="2,0,7,0" />

                    <ComboBox Grid.Column="1" x:Name="CboPrefix" Style="{StaticResource ThemedComboPill}"
                              SelectedIndex="0" Width="104" Height="26" Margin="0,0,6,0">
                        <ComboBoxItem Content="adb" />
                        <ComboBoxItem Content="fastboot" />
                        <ComboBoxItem Content="原样执行" />
                    </ComboBox>

                    <!-- 可编辑输入框：ThemedInputBox 已是唯一装饰（1px 描边 + 内边距），不再外套任何 Border -->
                    <TextBox Grid.Column="2" x:Name="TxtCommand" Style="{StaticResource ThemedInputBox}"
                             Padding="8,3" Height="26" KeyDown="TxtCommand_KeyDown" />

                    <Button Grid.Column="3" x:Name="BtnRun" Content="执行" Style="{StaticResource ThemedPrimaryButton}"
                            Click="BtnRun_Click" Height="26" MinWidth="72" Margin="6,0,0,0" />
                </Grid>

                <!-- 快捷操作行：沿用原有 4 个次级按钮（停止 / 清屏 / 打开系统 CMD / 检测工具），只换排版 -->
                <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="BtnStop" Content="停止" Style="{StaticResource ThemedFlatButton}"
                            Click="BtnStop_Click" IsEnabled="False" Height="26" Margin="0,0,6,0" />
                    <Button Content="清屏" Style="{StaticResource ThemedFlatButton}" Click="BtnClear_Click"
                            Height="26" Margin="0,0,6,0" />
                    <Button Content="系统 CMD" Style="{StaticResource ThemedFlatButton}" Click="BtnOpenCmd_Click"
                            Height="26" Margin="0,0,6,0" />
                    <Button x:Name="BtnCheckTools" Content="检测工具" Style="{StaticResource ThemedFlatButton}"
                            Click="BtnCheckTools_Click" Height="26" />
                </WrapPanel>

                <!-- 工具就绪状态提示：文案全部由代码写入（SetHint），这里只留初始文案 -->
                <TextBlock Grid.Row="3" x:Name="TxtHint" Text="回车执行；↑ / ↓ 翻历史命令。"
                           FontSize="11" Foreground="{DynamicResource Theme.TextTertiary}" Margin="0,6,0,0" />
            </Grid>
        </HeaderedContentControl>
    </Grid>
</services:BasePage>
