<Window x:Class="KunFlashTool.App.Dialogs.LoaderPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择引导程序" Height="592" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.Bg}"
        ResizeMode="NoResize">

    <Border x:Name="RootBorder" Background="{DynamicResource Theme.Bg}">
        <Grid Background="{DynamicResource Theme.Bg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 头部：窗口已是原生窗口，圆角与投影交给系统 -->
            <Border Grid.Row="0" Padding="20,14" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    Background="{DynamicResource Theme.Accent}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="选择引导程序" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtSubtitle" Text="已自动滤掉无关文件" Foreground="#CCFFFFFF" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- 根目录 -->
            <Grid Grid.Row="1" Margin="20,16,20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="目录" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource Theme.TextSecondary}" Margin="0,0,8,0"/>
                <Border Grid.Column="1" Background="{DynamicResource Theme.SurfaceAlt}" CornerRadius="{StaticResource R.Control}" Padding="9,6"
                        BorderBrush="{DynamicResource Theme.BorderSubtle}" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtRoot" Text="-" FontSize="11.5" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Theme.TextPrimary}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </Border>
                <Button Grid.Column="2" Content="更换目录" Style="{StaticResource ThemedFlatButton}" Height="30"
                        Padding="10,0" Margin="6,0,0,0" Click="BtnChangeRoot_Click"
                        ToolTip="换一个文件夹，下面会递归列出它里面所有可作引导程序的文件"/>
                <Button Grid.Column="3" Content="浏览任意文件…" Style="{StaticResource ThemedFlatButton}" Height="30"
                        Padding="10,0" Margin="6,0,0,0" Click="BtnBrowseAny_Click"
                        ToolTip="不走过滤，直接用系统文件对话框选任意文件"/>
            </Grid>

            <!-- 搜索 + 过滤开关 -->
            <Grid Grid.Row="2" Margin="20,0,20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Padding 必须覆盖掉样式里的 10,8：30 高的框扣掉上下 16px 内边距，
                     剩下的空间装不下 12px 字，文字会被整行裁掉（看起来就是个空框） -->
                <TextBox x:Name="TxtSearch" Grid.Column="0" Style="{StaticResource ThemedInputBox}" Height="30" FontSize="12"
                         Padding="10,0" VerticalContentAlignment="Center" TextChanged="TxtSearch_TextChanged"
                         GotFocus="TxtSearch_GotFocus" LostFocus="TxtSearch_LostFocus"
                         ToolTip="按品牌/机型筛选，例如 mi、oppo、redmagic、865"/>
                <CheckBox x:Name="ChkShowAll" Grid.Column="1" Style="{StaticResource ThemedCheckBox}" Content="显示全部文件"
                          VerticalAlignment="Center" Margin="12,0,0,0" Click="ChkShowAll_Click"
                          ToolTip="勾上后连 .txt/.json/.7z 等无关文件也一并列出"/>
                <TextBlock x:Name="TxtFilterInfo" Grid.Column="2" Text="" FontSize="11" VerticalAlignment="Center"
                           Margin="12,0,0,0" Foreground="{DynamicResource Theme.TextTertiary}"/>
            </Grid>

            <!-- 列表 -->
            <Border Grid.Row="3" Margin="20,0,20,0" Background="{DynamicResource Theme.Surface}"
                    BorderBrush="{DynamicResource Theme.BorderSubtle}" BorderThickness="1" CornerRadius="{StaticResource R.Control}" Padding="4">
                <DataGrid x:Name="DgLoaders" Style="{StaticResource ThemedDataGrid}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                          GridLinesVisibility="None" CanUserAddRows="False" CanUserDeleteRows="False"
                          FontSize="11.5" MouseDoubleClick="DgLoaders_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="文件（相对所选目录）" Binding="{Binding Relative}" Width="*"/>
                        <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="90"/>
                        <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="96"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 底部 -->
            <Border Grid.Row="4" Background="{DynamicResource Theme.SurfaceAlt}" CornerRadius="{StaticResource R.DialogBottom}" Padding="20,13" Margin="0,16,0,0">
                <Grid>
                    <TextBlock x:Name="TxtHint" Text="双击一行即可加载" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource Theme.TextTertiary}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Width="80" Height="32" Click="CloseButton_Click" Cursor="Hand" Margin="0,0,8,0"
                                Style="{StaticResource ThemedFlatButton}"/>
                        <Button Content="加载" Width="88" Height="32" Click="BtnConfirm_Click" Cursor="Hand"
                                Style="{StaticResource ThemedPrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
