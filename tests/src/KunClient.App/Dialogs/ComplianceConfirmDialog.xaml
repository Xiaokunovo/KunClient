<Window x:Class="KunFlashTool.App.Dialogs.ComplianceConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="合规确认" Height="474" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource Theme.Bg}">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,16" Background="{DynamicResource Theme.Accent}">
            <TextBlock x:Name="TxtTitle" Text="合规确认" Foreground="White" FontSize="16" FontWeight="Bold"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,16,20,8">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,14">
                    <TextBlock x:Name="TxtRisk" TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.TextSecondary}"
                               FontSize="12" LineHeight="21"/>
                </Border>

                <!-- 注意：不要把 Opacity 加在外层 Border 上 —— WPF 容器的 Opacity 会**连带子元素一起**乘，
                     原来 Opacity="0.16" 把这段必须阅读的警示文字压到 16% 不透明度（实际等于隐形）。
                     正确做法：底色与文字分成两层，只让底层色块半透明。 -->
                <Grid>
                    <Border CornerRadius="{StaticResource R.Card}"
                            Background="{DynamicResource Theme.LogWarning}" Opacity="0.16"
                            BorderBrush="{DynamicResource Theme.LogWarning}" BorderThickness="1"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextPrimary}"
                               FontSize="12" LineHeight="21" Margin="14,12">
                        仅可在设备为本人合法所有、或已获得设备所有者明确授权（如维修接单）的情况下继续。
                        严禁用于来历不明、遗失或被盗的设备。
                        <LineBreak/><LineBreak/>
                        将本功能用于他人或来历不明的设备，不只是违约，还可能构成刑事犯罪：
                        涉嫌《刑法》第285条（非法获取计算机信息系统数据、非法控制计算机信息系统罪）、
                        第286条（破坏计算机信息系统罪）、第264条（盗窃罪）、
                        第312条（掩饰、隐瞒犯罪所得、犯罪所得收益罪）、
                        第253条之一（侵犯公民个人信息罪），并可能触犯《反电信网络诈骗法》第14条。责任由操作者自负。
                    </TextBlock>
                </Grid>

                <CheckBox x:Name="ChkOwn" Margin="0,16,0,0" Checked="ChkOwn_Changed" Unchecked="ChkOwn_Changed"
                          Foreground="{DynamicResource Theme.TextPrimary}" FontSize="12.5">
                    <TextBlock TextWrapping="Wrap" Text="我确认该设备为本人合法所有，或已获得设备所有者的明确授权，并愿意承担相应责任。"/>
                </CheckBox>

                <CheckBox x:Name="ChkLegal" Margin="0,10,0,0" Checked="ChkOwn_Changed" Unchecked="ChkOwn_Changed"
                          Foreground="{DynamicResource Theme.TextPrimary}" FontSize="12.5">
                    <TextBlock TextWrapping="Wrap" Text="我已知晓：将该功能用于他人或来历不明的设备可能构成刑事犯罪，责任由我本人承担。"/>
                </CheckBox>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource Theme.SurfaceAlt}" Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="100" Height="36" Click="Cancel_Click" Cursor="Hand"
                        Margin="0,0,10,0" Style="{StaticResource ThemedFlatButton}"/>
                <Button x:Name="BtnOk" Content="确认执行" Width="110" Height="36" Click="Ok_Click"
                        Cursor="Hand" IsEnabled="False" Style="{StaticResource ThemedPrimaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
