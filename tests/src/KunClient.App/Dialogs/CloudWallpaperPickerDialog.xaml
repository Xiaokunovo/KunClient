<Window x:Class="KunFlashTool.App.Dialogs.CloudWallpaperPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="云端背景" Height="620" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.Bg}"
        ResizeMode="NoResize">

    <Border x:Name="RootBorder" Background="{DynamicResource Theme.Bg}">
        <Grid Background="{DynamicResource Theme.Bg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="20,14" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    Background="{DynamicResource Theme.Accent}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="云端背景" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="选一张下载到本机并设为背景，退出客户端时副本自动删除"
                               Foreground="#CCFFFFFF" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="20,16,20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TxtProgress" Text="双击一行即可下载并应用" FontSize="11"
                           VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextTertiary}"/>
                <Button Grid.Column="1" Content="刷新" Style="{StaticResource ThemedFlatButton}" Height="30" Padding="12,0"
                        Click="BtnRefresh_Click"/>
            </Grid>

            <Border Grid.Row="2" Margin="20,0,20,0" Background="{DynamicResource Theme.Surface}"
                    BorderBrush="{DynamicResource Theme.BorderSubtle}" BorderThickness="1" CornerRadius="{StaticResource R.Control}" Padding="4">
                <Grid>
                    <DataGrid x:Name="DgWallpapers" Style="{StaticResource ThemedDataGrid}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                              GridLinesVisibility="None" CanUserAddRows="False" CanUserDeleteRows="False"
                              FontSize="11.5" SelectionChanged="DgWallpapers_SelectionChanged"
                              MouseDoubleClick="DgWallpapers_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="90"/>
                            <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedText}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="TxtEmpty" Text="正在从服务器获取云端背景…" HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="420" Foreground="{DynamicResource Theme.TextTertiary}"/>
                </Grid>
            </Border>

            <Border Grid.Row="3" Background="{DynamicResource Theme.SurfaceAlt}" CornerRadius="{StaticResource R.DialogBottom}" Padding="20,13" Margin="0,16,0,0">
                <Grid>
                    <TextBlock Text="在控制台「账号设置 → 云端背景」可自行上传" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource Theme.TextTertiary}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Width="80" Height="32" Click="CloseButton_Click" Cursor="Hand" Margin="0,0,8,0"
                                Style="{StaticResource ThemedFlatButton}"/>
                        <Button x:Name="BtnConfirm" Content="下载并应用" Width="112" Height="32" Click="BtnConfirm_Click"
                                IsEnabled="False" Cursor="Hand" Style="{StaticResource ThemedPrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
