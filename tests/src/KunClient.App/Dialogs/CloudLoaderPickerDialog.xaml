<Window x:Class="KunFlashTool.App.Dialogs.CloudLoaderPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="云端引导库" Height="612" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.Bg}"
        ResizeMode="NoResize">

    <Border x:Name="RootBorder" Background="{DynamicResource Theme.Bg}">
        <Grid Background="{DynamicResource Theme.Bg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 头部：窗口已是原生窗口，圆角与投影交给系统 -->
            <Border Grid.Row="0" Padding="20,14" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    Background="{DynamicResource Theme.Accent}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="云端引导库" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtSubtitle" Text="按品牌 / 机型挑一个引导程序，直接下载并加载"
                               Foreground="#CCFFFFFF" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- 筛选栏 -->
            <Grid Grid.Row="1" Margin="20,16,20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="品牌" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource Theme.TextSecondary}" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbBrand" Grid.Column="1" Style="{StaticResource ThemedComboPill}" Height="30" FontSize="12"
                          SelectionChanged="CmbBrand_SelectionChanged"/>
                <!-- Padding 覆盖样式里的 10,8，否则 30 高的框会把 12px 字裁掉 -->
                <TextBox x:Name="TxtSearch" Grid.Column="2" Style="{StaticResource ThemedInputBox}" Height="30" FontSize="12"
                         Padding="10,0" VerticalContentAlignment="Center" Margin="8,0,0,0" TextChanged="TxtSearch_TextChanged"
                         ToolTip="按机型筛选，例如 865、y700、redmagic"/>
                <Button Grid.Column="3" Content="刷新" Style="{StaticResource ThemedFlatButton}" Height="30" Padding="12,0"
                        Margin="8,0,0,0" Click="BtnRefresh_Click"/>
            </Grid>

            <!-- 列表 -->
            <Border Grid.Row="2" Margin="20,0,20,0" Background="{DynamicResource Theme.Surface}"
                    BorderBrush="{DynamicResource Theme.BorderSubtle}" BorderThickness="1" CornerRadius="{StaticResource R.Control}" Padding="4">
                <Grid>
                    <DataGrid x:Name="DgLoaders" Style="{StaticResource ThemedDataGrid}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                              GridLinesVisibility="None" CanUserAddRows="False" CanUserDeleteRows="False"
                              FontSize="11.5" MouseDoubleClick="DgLoaders_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="品牌" Binding="{Binding Brand}" Width="110"/>
                            <DataGridTextColumn Header="机型" Binding="{Binding Model}" Width="*"/>
                            <!-- 「签名」= OPLUS 签名通道整套（同机型还有 .digest / .sig，点一次全下） -->
                            <DataGridTextColumn Header="通道" Binding="{Binding ChannelText}" Width="58"/>
                            <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="86"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="TxtEmpty" Text="正在从服务器获取引导库…" HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="420" Foreground="{DynamicResource Theme.TextTertiary}"/>
                </Grid>
            </Border>

            <!-- 底部 -->
            <Border Grid.Row="3" Background="{DynamicResource Theme.SurfaceAlt}" CornerRadius="{StaticResource R.DialogBottom}" Padding="20,13" Margin="0,16,0,0">
                <Grid>
                    <TextBlock x:Name="TxtHint" Text="双击一行即可下载并加载" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource Theme.TextTertiary}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Width="80" Height="32" Click="CloseButton_Click" Cursor="Hand" Margin="0,0,8,0"
                                Style="{StaticResource ThemedFlatButton}"/>
                        <Button x:Name="BtnConfirm" Content="下载并加载" Width="112" Height="32" Click="BtnConfirm_Click"
                                Cursor="Hand" Style="{StaticResource ThemedPrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
