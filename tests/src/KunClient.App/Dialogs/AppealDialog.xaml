<Window x:Class="KunFlashTool.App.Dialogs.AppealDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账号申诉" Height="700" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Theme.Bg}">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <!-- 状态条独立成行：提交后的成功/失败提示必须**永远可见**，
                 不能塞进滚动区（内容一多就滚到折叠线以下，用户以为没反应）。
                 窗口高度按「状态条也显示」的情况留足，出现时不挤压表单、不弹滚动条。 -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,16" Background="{DynamicResource Theme.Accent}">
            <TextBlock Text="账号被封禁 · 提交申诉" Foreground="White" FontSize="16" FontWeight="Bold"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,16,20,8">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,14">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextSecondary}"
                               FontSize="12" LineHeight="21">
                        你的账号因环境检测异常被自动封禁。如认为判定有误，可在此提交申诉，我们会人工复核。
                        <LineBreak/><LineBreak/>
                        ⚠️ 申诉提交后不会自动解封，需管理员人工确认。同一账号仅允许 1 条待处理申诉、7 天内限 1 次。
                    </TextBlock>
                </Border>

                <TextBlock Text="账号名" Foreground="{DynamicResource Theme.TextPrimary}" FontSize="12.5" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtUsername" MinHeight="34" Padding="10,0" VerticalContentAlignment="Center"
                         FontSize="13" Margin="0,0,0,14"/>

                <TextBlock Text="申诉说明（10 - 1000 字，请尽量说明你的正常使用场景）" Foreground="{DynamicResource Theme.TextPrimary}" FontSize="12.5" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtContent" MinHeight="140" Padding="10" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" FontSize="13" Margin="0,0,0,14"/>

                <TextBlock Text="联系方式（选填：邮箱 / QQ，便于回访）" Foreground="{DynamicResource Theme.TextPrimary}" FontSize="12.5" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtContact" MinHeight="34" Padding="10,0" VerticalContentAlignment="Center"
                         FontSize="13" Margin="0,0,0,4"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 状态条：钉在滚动区与按钮之间，始终可见 -->
        <Border x:Name="StatusBorder" Grid.Row="2" Visibility="Collapsed"
                Padding="20,0,20,10">
            <Border x:Name="StatusInner" Padding="12,10" CornerRadius="{StaticResource R.Card}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusIcon" FontSize="14" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource Theme.SurfaceAlt}"
                CornerRadius="{StaticResource R.DialogBottom}" Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="100" Height="36" Click="Cancel_Click" Cursor="Hand"
                        Margin="0,0,10,0" Style="{StaticResource ThemedFlatButton}"/>
                <Button x:Name="BtnSubmit" Content="提交申诉" Width="110" Height="36" Click="Submit_Click"
                        Cursor="Hand" Style="{StaticResource ThemedPrimaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
