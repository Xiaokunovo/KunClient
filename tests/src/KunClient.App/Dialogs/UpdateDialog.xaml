<Window x:Class="KunFlashTool.App.Dialogs.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="软件更新" Height="472" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.Bg}"
        ResizeMode="NoResize">

    <Border Background="{DynamicResource Theme.Bg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏：窗口已是原生窗口，关闭交给系统标题栏的 × -->
            <Border Grid.Row="0" Background="{DynamicResource Theme.Surface}" Padding="24,16"
                    BorderBrush="{DynamicResource Theme.BorderSubtle}" BorderThickness="0,0,1,0">
                <TextBlock Text="软件更新" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.TextPrimary}" VerticalAlignment="Center"/>
            </Border>

            <!-- 内容 -->
            <Grid Grid.Row="1" Margin="24,20">
                <!-- 检查中 -->
                <StackPanel x:Name="CheckingPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="{StaticResource R.Card}" Background="{DynamicResource Theme.AccentSubtle}"
                            HorizontalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                   Foreground="{DynamicResource Theme.AccentText2}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="正在检查更新..." FontSize="14" Foreground="{DynamicResource Theme.TextSecondary}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 已是最新 -->
                <StackPanel x:Name="NoUpdatePanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="{StaticResource R.Card}" Background="{DynamicResource Theme.SuccessBg}"
                            HorizontalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                   Foreground="{DynamicResource Theme.Success}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="已是最新版本" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.TextPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CurrentVersionText" Text="当前版本: v1.1.3.1" FontSize="12"
                               Foreground="{DynamicResource Theme.TextTertiary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- 发现新版本 -->
                <StackPanel x:Name="UpdatePanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock x:Name="NewVersionText" Text="v1.1.3 → v1.1.3.1" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.AccentText2}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="BuildDateText" Text="" FontSize="11"
                               Foreground="{DynamicResource Theme.TextTertiary}" HorizontalAlignment="Center" Margin="0,4,0,14"/>

                    <Border Background="{DynamicResource Theme.SurfaceAlt}" CornerRadius="{StaticResource R.Card}" Padding="14"
                            BorderBrush="{DynamicResource Theme.BorderSubtle}" BorderThickness="1" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="更新内容" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.TextSecondary}" Margin="0,0,0,5"/>
                            <TextBlock x:Name="ChangelogText" Text="" FontSize="12"
                                       Foreground="{DynamicResource Theme.TextPrimary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <ProgressBar x:Name="ProgressBar" Style="{StaticResource RoundedProgressBar}"
                                 Height="6" Value="0" Visibility="Collapsed"/>
                    <TextBlock x:Name="StatusText" Text="" FontSize="11"
                               Foreground="{DynamicResource Theme.TextTertiary}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- 错误 -->
                <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="{StaticResource R.Card}" Background="{DynamicResource Theme.DangerBg}"
                            HorizontalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                   Foreground="{DynamicResource Theme.Danger}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="检查更新失败" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.TextPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ErrorText" Text="" FontSize="12"
                               Foreground="{DynamicResource Theme.TextTertiary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 按钮 -->
            <Border Grid.Row="2" Background="{DynamicResource Theme.Surface}" Padding="24,16"
                    BorderBrush="{DynamicResource Theme.BorderSubtle}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CheckButton" Content="重新检查" Click="CheckButton_Click"
                            Style="{StaticResource ThemedFlatButton}" Height="36" MinWidth="88" Margin="0,0,8,0"/>
                    <Button Content="关闭" Click="CloseButton_Click"
                            Style="{StaticResource ThemedFlatButton}" Height="36" MinWidth="80" Margin="0,0,8,0"/>
                    <Button x:Name="UpdateButton" Content="立即更新" Click="UpdateButton_Click"
                            Style="{StaticResource ThemedPrimaryButton}" Height="36" MinWidth="104" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
