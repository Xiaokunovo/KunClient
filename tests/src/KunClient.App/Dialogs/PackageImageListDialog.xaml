<Window x:Class="KunFlashTool.App.Dialogs.PackageImageListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="包内镜像清单" Height="620" Width="900" MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.Bg}"
        ResizeMode="CanResize">

    <Border x:Name="RootBorder" Background="{DynamicResource Theme.Bg}">
        <Grid Background="{DynamicResource Theme.Bg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 头部 -->
            <Border Grid.Row="0" Padding="20,14" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    Background="{DynamicResource Theme.Accent}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="包内镜像清单" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="逐个 rawprogram 条目列出，包含同一分区的多块镜像（super_1..N / userdata_1..N）"
                               Foreground="#CCFFFFFF" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- 汇总 + 过滤 -->
            <Grid Grid.Row="1" Margin="20,14,20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtSummary" Grid.Column="0" Text="正在解析…" TextWrapping="Wrap"
                           VerticalAlignment="Center" FontSize="11.5"
                           Foreground="{DynamicResource Theme.TextSecondary}"/>
                <CheckBox x:Name="ChkOnlyFlash" Grid.Column="1" Content="只看会刷写的条目" FontSize="11.5"
                          VerticalAlignment="Center" Margin="12,0,0,0"
                          Foreground="{DynamicResource Theme.TextPrimary}"
                          Checked="ChkOnlyFlash_Changed" Unchecked="ChkOnlyFlash_Changed"/>
            </Grid>

            <!-- 列表 -->
            <Border Grid.Row="2" Margin="20,0,20,0" Background="{DynamicResource Theme.Surface}"
                    BorderBrush="{DynamicResource Theme.BorderSubtle}" BorderThickness="1"
                    CornerRadius="{StaticResource R.Control}" Padding="4">
                <Grid>
                    <DataGrid x:Name="DgImages" Style="{StaticResource ThemedDataGrid}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                              GridLinesVisibility="None" CanUserAddRows="False" CanUserDeleteRows="False"
                              FontSize="11.5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="分区" Binding="{Binding Label}" Width="150"/>
                            <DataGridTextColumn Header="块" Binding="{Binding ChunkText}" Width="70"/>
                            <DataGridTextColumn Header="LUN" Binding="{Binding LunText}" Width="60"/>
                            <DataGridTextColumn Header="起始扇区" Binding="{Binding StartSectorText}" Width="150"/>
                            <DataGridTextColumn Header="扇区数" Binding="{Binding NumSectorsText}" Width="90"/>
                            <DataGridTextColumn Header="镜像文件" Binding="{Binding FileText}" Width="*"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="TxtEmpty" Text="当前资料目录内没有找到 rawprogram XML。" TextWrapping="Wrap"
                               TextAlignment="Center" MaxWidth="420" Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource Theme.TextTertiary}"/>
                </Grid>
            </Border>

            <!-- 底部 -->
            <Border Grid.Row="3" Background="{DynamicResource Theme.SurfaceAlt}"
                    CornerRadius="{StaticResource R.DialogBottom}" Padding="20,13" Margin="0,16,0,0">
                <Grid>
                    <TextBlock Text="「占位」条目在 rawprogram 里没有镜像文件（QFIL 语义：只登记分区，不下发数据，也不擦除）。"
                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource Theme.TextTertiary}"/>
                    <Button Content="关闭" Width="88" Height="32" HorizontalAlignment="Right"
                            Click="CloseButton_Click" Cursor="Hand"
                            Style="{StaticResource ThemedFlatButton}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
