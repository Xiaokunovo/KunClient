<UserControl x:Class="KunFlashTool.App.Controls.PageHeaderBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- 统一的页面标题栏：标题 + 副标题 +（可选）右侧动作区。
         各页面共用它，避免「有的页面有标题、有的没有」「标题样式各不相同」。
         底部发丝线把标题区与内容分开，标题不再是一行浮在背景上的字。
         ★ 左侧原有的「品牌图标方块」（32x32 圆角 + 闪电字形）已按需求整块移除：
           那是残留在每个页面标题左边的 logo 标记。 -->
    <Border Padding="2,0,2,12" Margin="0,0,0,14"
            BorderBrush="{DynamicResource Theme.BorderSubtle}" BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.TextPrimary}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SubtitleText" FontSize="11" Margin="0,1,0,0"
                           Foreground="{DynamicResource Theme.TextTertiary}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- 页面各自的动作按钮放在这里（可为空） -->
            <ContentPresenter Grid.Column="1" x:Name="ActionsHost" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
